---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
}

const {
  title = "Velcorix - Mechanical Equipment Trading UAE",
  description = "Velcorix is a leading mechanical equipment trading company in UAE, supplying quality industrial hardware, PPE, welding consumables, structural steel, ATEX products, and more across the Middle East.",
  image = "/assets/images/logo/velcorix-logo.png",
  robots = "index, follow",
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes = "100vw",
} = Astro.props;

const siteOrigin = Astro.site ? (typeof Astro.site === 'string' ? Astro.site : Astro.site.origin) : 'https://www.velcorix.com';
const canonicalURL = new URL(Astro.url.pathname, siteOrigin).href;
const ogImageURL = image.startsWith('http') ? image : new URL(image, siteOrigin).href;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Velcorix",
  "url": "https://www.velcorix.com",
  "logo": "https://www.velcorix.com/assets/images/logo/velcorix-logo.png",
  "description": "Leading mechanical equipment trading company in UAE, supplying quality industrial hardware, PPE, welding consumables, structural steel, ATEX products, and more.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Dubai",
    "addressCountry": "AE"
  }
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Velcorix" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Preconnect origins -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    {preloadImage && (
      <!-- LCP Image Preload -->
      <link
        rel="preload"
        as="image"
        href={preloadImage}
        imagesrcset={preloadImageSrcset}
        imagesizes={preloadImageSrcset ? preloadImageSizes : undefined}
        fetchpriority="high"
      />
    )}

    <!-- Preload critical Font Awesome webfonts -->
    <link
      rel="preload"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/webfonts/fa-solid-900.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/webfonts/fa-brands-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Google Fonts (Non-render-blocking with display=swap) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600&family=Poppins:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600&family=Poppins:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600&family=Poppins:wght@400;500;600;700&display=swap"
      />
    </noscript>
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <!-- FontAwesome (Optimized Local Subset - Zero Unused CSS) -->
    <link rel="stylesheet" href="/assets/css/fontawesome-subset.css" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/assets/css/style.css" />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <!-- Deferred Scripts (Non-blocking) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" defer is:inline></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer is:inline></script>
    <script src="/assets/js/main.js" defer is:inline></script>
    <script src="/assets/js/chatbot.js" defer is:inline></script>
  </body>
</html>
