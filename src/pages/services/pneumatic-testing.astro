---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Pneumatic Testing - Velcorix Services" description="High-pressure pneumatic testing services in UAE. Velcorix conducts safe air and nitrogen pressure tests for pipelines and vessels using high-volume compressors and digital monitoring.">
<!-- Header (Hero) -->
    <PageHeader 
      title="Pneumatic Testing" 
      subtitle="Air and Gas Pressure Testing Services" 
      bgImage="/assets/images/services/DSC_2439.JPG" 
    />

    <!-- Overview (Intro) -->
    <section class="section-padding">
      <div class="container">
        <div class="row">
          <div class="col-lg-6">
            <img
              src="/assets/images/services/pneumatic-test.png"
              class="img-fluid shadow intro-image"
              alt="Pneumatic Testing"
              onerror="this.src='https://placehold.co/800x400?text=Pneumatic+Testing'"
            />
          </div>
          <div class="col-lg-6 mb-4">
            <h2 class="mb-3">Precision Pressure Verification</h2>
            <p>
              Pneumatic testing uses air or inert gas such as nitrogen to verify the integrity and leak-tightness of pipelines and pressure vessels. Unlike hydrostatic testing, it is suitable for systems where water contact is prohibitive or for detecting very small leaks.
            </p>
            <p>
              Velcorix conducts these high-risk tests with meticulous planning, exclusion zones, and remote monitoring to ensure absolute safety and compliance with ASME/API standards.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included (Key Offerings) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="section-title">
          <h2>Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Nitrogen Testing</h5>
                <p class="text-muted mb-0">High-purity leak testing for process systems sensitive to moisture.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Air Pressure Tests</h5>
                <p class="text-muted mb-0">Compressed air testing for instrument air lines and utility piping.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Helium Leak Detection</h5>
                <p class="text-muted mb-0">Trace gas detection for identifying microscopic leaks in flange joints.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
             <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Reinstate & Purge</h5>
                <p class="text-muted mb-0">Safe depressurization and inerting of systems post-test.</p>
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- Typical Applications -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
          <h2>Typical Real-World Applications</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-gas-pump"></i>
              </div>
              <h4>Gas Pipelines</h4>
              <p class="small text-muted mb-0">
                Testing of transmission lines where hydrotesting is not feasible.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-snowflake"></i>
              </div>
              <h4>Cryogenic</h4>
              <p class="small text-muted mb-0">
                Testing LNG lines which must remain absolutely dry.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-microchip"></i>
              </div>
              <h4>Instrument Air</h4>
              <p class="small text-muted mb-0">
                Verifying control system tubing and manifolds.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-box-open"></i>
              </div>
              <h4>Vessels</h4>
              <p class="small text-muted mb-0">
                 Low-pressure integrity checks on storage tanks.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capability Details (How We Do It) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="mb-4 fw-bold">Capability Details</h2>
                <div class="bg-white p-4 rounded shadow-sm">
                   <p class="text-muted">
                    Safety is our primary capability when dealing with stored energy in pneumatic tests.
                   </p>
                   <ul class="list-unstyled">
                      <li class="mb-3 d-flex align-items-start">
                        <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                        <div>
                          <strong>Calculations:</strong> Comprehensive stored energy calculations to determine safe distances.
                        </div>
                      </li>
                      <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Equipment:</strong> High-volume compressors (up to 1600 CFM) and boosters (up to 15,000 PSI).
                         </div>
                       </li>
                       <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Monitoring:</strong> Digital chart recorders for real-time pressure and temperature logging.
                         </div>
                       </li>
                   </ul>
                </div>
            </div>
            <div class="col-lg-6">
                 <img src="/assets/images/services/DSC_2447.JPG" alt="Testing Capabilities" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Testing+Capabilities'">
            </div>
        </div>
      </div>
    </section>

    <!-- Compliance & Support -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
            <h2>Compliance Standards</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-book text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">ASME B31.3</h6>
                <p class="small text-muted mb-0">Adherence to Process Piping testing codes.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-exclamation-triangle text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Risk Assessment</h6>
                <p class="small text-muted mb-0">Detailed TRA covering blast zones and exclusion barriers.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-file-invoice text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Certification</h6>
                <p class="small text-muted mb-0">Third-party calibrated gauges and recorders.</p>
             </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section text-center text-white">
      <div class="container">
        <h2 class="cta-heading">Verify Integrity Safely</h2>
        <p class="cta-subtext">
          Trust Velcorix for compliant and safe pneumatic testing.
        </p>
        <a href="/contact" class="btn btn-primary btn-lg mt-3"
          >Request Testing Service</a
        >
      </div>
      <div class="footer-divider"></div>
    </section>

    <!-- Footer -->
</BaseLayout>

