      <div class="container">
        <div class="section-title">
          <h2>Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Process Engineers</h5>
                <p class="text-muted mb-0">For method statement development and system walk-downs.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Hydrotest Crews</h5>
                <p class="text-muted mb-0">Supervisors and technicians for pressure testing operations.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Pigging Specialists</h5>
                <p class="text-muted mb-0">Experts in launching and receiving cleaning pigs.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
             <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Leak Testing Teams</h5>
                <p class="text-muted mb-0">Nitrogen helium leak detection personnel.</p>
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- Typical Applications -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
          <h2>Typical Real-World Applications</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-tint"></i>
              </div>
              <h4>Pipeline Flooding</h4>
              <p class="small text-muted mb-0">
                Controlled filling of pipelines for hydrotesting.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-broom"></i>
              </div>
              <h4>Chemical Cleaning</h4>
              <p class="small text-muted mb-0">
                Staffing for chemical circulation skids.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-wind"></i>
              </div>
              <h4>Air Blowing</h4>
              <p class="small text-muted mb-0">
                Operators for high-capacity air compressors.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-check-double"></i>
              </div>
              <h4>Loop Checks</h4>
              <p class="small text-muted mb-0">
                 E&I technicians for instrument loop verification.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capability Details (How We Do It) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="mb-4 fw-bold">Capability Details</h2>
                <div class="bg-white p-4 rounded shadow-sm">
                   <p class="text-muted">
                    Pre-commissioning requires a specialized blend of operational knowledge and testing expertise.
                   </p>
                   <ul class="list-unstyled">
                      <li class="mb-3 d-flex align-items-start">
                        <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                        <div>
                          <strong>Integrated Crews:</strong> Teams that can handle mechanical assembly and testing concurrently.
                        </div>
                      </li>
                      <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Documentation:</strong> Technicians trained in MC (Mechanical Completion) punch-listing.
                         </div>
                       </li>
                       <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Safety Protocols:</strong> High awareness of stored energy hazards during pressure tests.
                         </div>
                       </li>
                   </ul>
                </div>
            </div>
            <div class="col-lg-6">
                 <img src="/assets/images/services/DSC_2414.JPG" alt="Precomm Capabilities" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Precomm+Capabilities'">
            </div>
        </div>
      </div>
    </section>

    <!-- Compliance & Support -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
            <h2>Compliance & Support</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-file-contract text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Procedures</h6>
                <p class="small text-muted mb-0">Adherence to project-specific pre-commissioning procedures.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-certificate text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Certification</h6>
                <p class="small text-muted mb-0">Personnel with specific competency cards for pressure testing.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-clipboard-list text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Sign-Off</h6>
                <p class="small text-muted mb-0">Experience in walk-downs and system handover to operations.</p>
             </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section text-center text-white">
      <div class="container">
        <h2 class="cta-heading">Ensure a Smooth Start</h2>
        <p class="cta-subtext">
          Deploy Velcorix's pre-commissioning experts for a flawless startup.
        </p>
        <a href="/contact" class="btn btn-primary btn-lg mt-3"
          >Request a Team</a
        >
      </div>
      <div class="footer-divider"></div>
    </section>

    <!-- Footer -->
</BaseLayout>

