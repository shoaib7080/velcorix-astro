---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Pre-commissioning Manpower - Velcorix Services" description="Specialized pre-commissioning manpower in UAE. Velcorix provides expert teams for pipeline cleaning, gauging, drying, and pressure testing to ensure system readiness.">
<!-- Header (Hero) -->
    <PageHeader 
      title="Pre-commissioning Manpower" 
      subtitle="Expert Teams for System Testing and Startup" 
      bgImage="/assets/images/services/DSC_2407.JPG" 
    />

    <!-- Overview (Intro) -->
    <section class="section-padding">
      <div class="container">
        <div class="row">
          <div class="col-lg-6">
            <img
              src="/assets/images/services/DSC_2408.JPG"
              class="img-fluid shadow intro-image"
              alt="Pre-commissioning Manpower"
              onerror="this.src='https://placehold.co/800x400?text=Precomm+Manpower'"
            />
          </div>
          <div class="col-lg-6 mb-4">
            <h2 class="mb-3">Ensuring System Readiness</h2>
            <p>
              Before a plant goes live, it must be rigorously tested. Velcorix provides specialized manpower teams dedicated to pre-commissioning activities such as cleaning, gauging, drying, and pressure testing of pipelines and process systems.
            </p>
            <p>
              Our personnel are familiar with the specific equipment and protocols required to verify system integrity before the introduction of hydrocarbons.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included (Key Offerings) -->
