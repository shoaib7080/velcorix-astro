---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="HAC Manpower - Velcorix Services" description="Qualified HVAC and climate control manpower in UAE. Velcorix provides expert technicians for industrial chiller maintenance, control room cooling, and ventilation systems.">
<!-- Header (Hero) -->
    <PageHeader 
      title="HAC Manpower" 
      subtitle="Specialized HVAC Technicians for Industrial Environments" 
      bgImage="/assets/images/services/DSC_2407.JPG" 
    />

    <!-- Overview (Intro) -->
    <section class="section-padding">
      <div class="container">
        <div class="row">
          <div class="col-lg-6">
            <img
              src="/assets/images/services/DSC_2408.JPG"
              class="img-fluid shadow intro-image"
              alt="HAC Manpower"
              onerror="this.src='https://placehold.co/800x400?text=HAC+Manpower'"
            />
          </div>
          <div class="col-lg-6 mb-4">
            <h2 class="mb-3">Climate Control Specialists</h2>
            <p>
              In the extreme climates of the Middle East, Heating, Air Conditioning, and Cooling (HAC) systems are not just a luxury but a necessity for operational safety and equipment efficiency. Velcorix provides skilled HAC technicians specializing in industrial chillers, control room A/C, and accommodation cooling.
            </p>
            <p>
              Our workforce is adept at installation, troubleshooting, and preventive maintenance of large-scale HVAC systems.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included (Key Offerings) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="section-title">
          <h2>Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">HVAC Technicians</h5>
                <p class="text-muted mb-0">Experts in troubleshooting refrigeration cycles and electrical controls.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Chiller Mechanics</h5>
                <p class="text-muted mb-0">Specialized in maintenance of industrial water-cooled and air-cooled chillers.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Duct Fabricators</h5>
                <p class="text-muted mb-0">Skilled in fabrication and installation of ventilation ductwork.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
             <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">BMS Operators</h5>
                <p class="text-muted mb-0">Personnel trained in Building Management Systems for automated control.</p>
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- Typical Applications -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
          <h2>Typical Real-World Applications</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-server"></i>
              </div>
              <h4>Control Rooms</h4>
              <p class="small text-muted mb-0">
                Precision cooling for sensitive electronic equipment.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-hotel"></i>
              </div>
              <h4>Labor Camps</h4>
              <p class="small text-muted mb-0">
                Maintenance of AC units for large accommodation blocks.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-industry"></i>
              </div>
              <h4>Process Cooling</h4>
              <p class="small text-muted mb-0">
                Maintaining chillers used in industrial heat exchange.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-fan"></i>
              </div>
              <h4>Ventilation</h4>
              <p class="small text-muted mb-0">
                 Exhaust systems for workshops and enclosed spaces.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capability Details (How We Do It) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="mb-4 fw-bold">Capability Details</h2>
                <div class="bg-white p-4 rounded shadow-sm">
                   <p class="text-muted">
                    We ensure optimal indoor air quality and temperature control through diverse technical expertise.
                   </p>
                   <ul class="list-unstyled">
                      <li class="mb-3 d-flex align-items-start">
                        <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                        <div>
                          <strong>Certified Staff:</strong> Technicians certified in refrigerant handling to prevent environmental damage.
                        </div>
                      </li>
                      <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Tooling:</strong> Teams equipped with latest diagnostic tools for gas leak detection.
                         </div>
                       </li>
                       <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Efficiency:</strong> Focus on optimizing system performance to reduce energy consumption.
                         </div>
                       </li>
                   </ul>
                </div>
            </div>
            <div class="col-lg-6">
                 <img src="/assets/images/services/DSC_2414.JPG" alt="HAC Capabilities" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=HAC+Capabilities'">
            </div>
        </div>
      </div>
    </section>

    <!-- Compliance & Support -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
            <h2>Compliance Standards</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-globe-americas text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Environmental</h6>
                <p class="small text-muted mb-0">Compliance with regulations regarding ozone-depleting substances.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-thermometer-half text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">ASHRAE</h6>
                <p class="small text-muted mb-0">Adherence to international standards for HVAC design and maintenance.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-bolt text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Electrical Safety</h6>
                <p class="small text-muted mb-0">Strict isolation procedures (LOTO) during maintenance.</p>
             </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section text-center text-white">
      <div class="container">
        <h2 class="cta-heading">Cooling Solutions that Work</h2>
        <p class="cta-subtext">
          Keep your operations running cool with Velcorix HAC services.
        </p>
        <a href="/contact" class="btn btn-primary btn-lg mt-3"
          >Get HVAC Support</a
        >
      </div>
      <div class="footer-divider"></div>
    </section>

    <!-- Footer -->
</BaseLayout>

