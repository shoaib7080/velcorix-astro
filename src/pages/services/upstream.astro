---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Upstream Services - Velcorix Services" description="Comprehensive upstream oil and gas services in UAE. Velcorix provides expert wellhead maintenance, drilling support, and field development solutions to optimize production.">
<!-- Header (Hero) -->
    <PageHeader 
      title="Oil & Gas Upstream" 
      subtitle="Exploration and Production Operational Excellence" 
      bgImage="/assets/images/services/DSC_2482.JPG" 
    />

    <!-- Overview (Intro) -->
    <section class="section-padding">
      <div class="container">
        <div class="row">
          <div class="col-lg-6">
            <img
              src="/assets/images/services/DSC_2493.JPG"
              class="img-fluid shadow intro-image"
              alt="Upstream Services"
              onerror="this.src='https://placehold.co/800x400?text=Upstream+Services'"
            />
          </div>
          <div class="col-lg-6 mb-4">
            <h2 class="mb-3">Upstream Support Solutions</h2>
            <p>
              Velcorix provides a suite of specialized services designed to optimize upstream operations. From exploration support to production enhancement, we help operators maximize recovery while ensuring the highest safety standards.
            </p>
            <p>
              Our team understands the unique challenges of remote and demanding oilfield environments, delivering reliable equipment and skilled manpower exactly where it's needed.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included (Key Offerings) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="section-title">
          <h2>Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Wellhead Maintenance</h5>
                <p class="text-muted mb-0">Routine inspection, greasing, and valve integrity checks.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Drilling Support</h5>
                <p class="text-muted mb-0">Provision of auxiliary equipment and manpower for rig operations.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Geological Survey Support</h5>
                <p class="text-muted mb-0">Logistics and site preparation for seismic and geological teams.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
             <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Field Development</h5>
                <p class="text-muted mb-0">Early production facility (EPF) support and equipment rental.</p>
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- Typical Applications -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
          <h2>Typical Real-World Applications</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-oil-well"></i>
              </div>
              <h4>Onshore Rigs</h4>
              <p class="small text-muted mb-0">
                Support for active drilling and workover rigs.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-map-marked-alt"></i>
              </div>
              <h4>Exploration Sites</h4>
              <p class="small text-muted mb-0">
                Camp setup and logistics for remote survey teams.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-tint"></i>
              </div>
              <h4>Water Mgmt</h4>
              <p class="small text-muted mb-0">
                Produced water treatment and disposal support.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-tools"></i>
              </div>
              <h4>Maintenance</h4>
              <p class="small text-muted mb-0">
                 Preventive maintenance of surface production facilities.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capability Details (How We Do It) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="mb-4 fw-bold">Capability Details</h2>
                <div class="bg-white p-4 rounded shadow-sm">
                   <p class="text-muted">
                    We combine technical expertise with rapid mobilization capabilities to support uninterrupted production.
                   </p>
                   <ul class="list-unstyled">
                      <li class="mb-3 d-flex align-items-start">
                        <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                        <div>
                          <strong>Rapid Response:</strong> 24/7 availability for critical equipment dispatch to remote well sites.
                        </div>
                      </li>
                      <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Integrated Services:</strong> Offering a 'one-stop-shop' for mechanical, electrical, and instrumentation support.
                         </div>
                       </li>
                       <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>HSE Leadership:</strong> Strict adherence to oilfield safety protocols including H2S awareness and defensive driving.
                         </div>
                       </li>
                   </ul>
                </div>
            </div>
            <div class="col-lg-6">
                 <img src="/assets/images/services/DSC_2558.JPG" alt="Upstream Capabilities" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Upstream+Capabilities'">
            </div>
        </div>
      </div>
    </section>

    <!-- Compliance & Support -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
            <h2>Compliance & Support</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-shield-alt text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">HSE Focus</h6>
                <p class="small text-muted mb-0">Zero LTI target with comprehensive safety induction programs.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-check-double text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Asset Integrity</h6>
                <p class="small text-muted mb-0">Ensuring equipment reliability through predictive maintenance.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-file-signature text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Permit to Work</h6>
                <p class="small text-muted mb-0">Strict adherence to operator's PTW systems.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-globe text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Logistics</h6>
                <p class="small text-muted mb-0">Expertise in moving heavy equipment across challenging terrain.</p>
             </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section text-center text-white">
      <div class="container">
        <h2 class="cta-heading">Maximize Field Potential</h2>
        <p class="cta-subtext">
          Partner with Velcorix for reliable upstream support services.
        </p>
        <a href="/contact" class="btn btn-primary btn-lg mt-3"
          >Contact Us</a
        >
      </div>
      <div class="footer-divider"></div>
    </section>

    <!-- Footer -->
</BaseLayout>

