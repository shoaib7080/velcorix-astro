---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Offshore Services - Velcorix Services" description="Expert offshore support services in UAE. Velcorix provides DNV certified equipment rentals, deck machinery maintenance, and subsea operation support for marine assets.">
<!-- Header (Hero) -->
    <PageHeader 
      title="Offshore Services" 
      subtitle="Marine and Offshore Platform Support" 
      bgImage="/assets/images/services/offshore-2.jpg" 
    />

    <!-- Overview (Intro) -->
    <section class="section-padding">
      <div class="container">
        <div class="row">
          <div class="col-lg-6">
            <img
              src="/assets/images/services/offshore-3.jpg"
              class="img-fluid shadow intro-image"
              alt="Offshore Services"
              onerror="this.src='https://placehold.co/800x400?text=Offshore+Services'"
            />
          </div>
          <div class="col-lg-6 mb-4">
            <h2 class="mb-3">Offshore Excellence</h2>
            <p>
              Operating in harsh marine environments requires reliable partners. Velcorix delivers specialized support for offshore platforms, FPSOs, and marine vessels, ensuring that equipment is always certified and operations are safe.
            </p>
            <p>
              We understand the logistical challenges of offshore work. Our services are designed to maximize uptime and minimize the need for shore-based intervention.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included (Key Offerings) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="section-title">
          <h2>Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Container Rentals</h5>
                <p class="text-muted mb-0">DNV 2.7-1 certified offshore containers and baskets.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Deck Machinery</h5>
                <p class="text-muted mb-0">Maintenance of winches, cranes, and anchor handling equipment.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Subsea Support</h5>
                <p class="text-muted mb-0">Provision of auxiliary equipment for diving and ROV operations.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
             <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Coating & Preservation</h5>
                <p class="text-muted mb-0">Marine-grade corrosion protection for topside assets.</p>
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- Typical Applications -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
          <h2>Typical Real-World Applications</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-ship"></i>
              </div>
              <h4>Vessel Support</h4>
              <p class="small text-muted mb-0">
                Maintenance for OSVs and supply boats.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-building"></i>
              </div>
              <h4>Platforms</h4>
              <p class="small text-muted mb-0">
                Integrity management for fixed drilling and production rigs.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-anchor"></i>
              </div>
              <h4>Subsea</h4>
              <p class="small text-muted mb-0">
                Equipment support for underwater construction.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-toolbox"></i>
              </div>
              <h4>Workshops</h4>
              <p class="small text-muted mb-0">
                 Offshore containerized workshops for on-site repairs.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capability Details (How We Do It) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="mb-4 fw-bold">Capability Details</h2>
                <div class="bg-white p-4 rounded shadow-sm">
                   <p class="text-muted">
                    We ensure all equipment and personnel dispatched offshore meet the highest international standards of safety and reliability.
                   </p>
                   <ul class="list-unstyled">
                      <li class="mb-3 d-flex align-items-start">
                        <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                        <div>
                          <strong>Certification:</strong> All lifting gear and containers come with valid third-party survey reports (TPI).
                        </div>
                      </li>
                      <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Training:</strong> Personnel hold valid BOSIET and HUET certifications for offshore travel.
                         </div>
                       </li>
                       <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Durability:</strong> Equipment is specially designed or treated to withstand harsh saline environments.
                         </div>
                       </li>
                   </ul>
                </div>
            </div>
            <div class="col-lg-6">
                 <img src="/assets/images/services/offshore.jpg" alt="Offshore Capabilities" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Offshore+Capabilities'">
            </div>
        </div>
      </div>
    </section>

    <!-- Compliance & Support -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
            <h2>Compliance & Support</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-file-contract text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">DNV Standards</h6>
                <p class="small text-muted mb-0">Equipment built to DNV 2.7-1 / EN 12079.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-life-ring text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Safety Training</h6>
                <p class="small text-muted mb-0">Crew trained in sea survival and firefighting.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-clipboard-check text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Traceability</h6>
                <p class="small text-muted mb-0">Full documentation history for all rental assets.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-clock text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Logistics</h6>
                <p class="small text-muted mb-0">Seamless coordination with supply vessels and helicopters.</p>
             </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section text-center text-white">
      <div class="container">
        <h2 class="cta-heading">Support Your Offshore Operations</h2>
        <p class="cta-subtext">
          Rent certified equipment and get expert marine support from Velcorix.
        </p>
        <a href="/contact" class="btn btn-primary btn-lg mt-3"
          >Request Quote</a
        >
      </div>
      <div class="footer-divider"></div>
    </section>

    <!-- Footer -->
</BaseLayout>

