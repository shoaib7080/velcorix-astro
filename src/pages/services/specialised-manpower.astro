---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Specialised Manpower - Velcorix Services" description="Expert specialized manpower supply in UAE. Velcorix provides certified professionals for shutdowns, pre-commissioning, lifting operations, and HAC systems.">
<!-- Header (Hero) -->
    <PageHeader 
      title="Specialised Manpower" 
      subtitle="Expert Workforce Solutions for Industry" 
      bgImage="/assets/images/services/DSC_2407.JPG" 
    />

    <!-- Overview (Intro) -->
    <section class="section-padding">
      <div class="container">
        <div class="row">
          <div class="col-lg-6">
            <img
              src="/assets/images/services/DSC_2408.JPG"
              class="img-fluid shadow intro-image"
              alt="Manpower Overview"
              onerror="this.src='https://placehold.co/800x400?text=Expert+Manpower'"
            />
          </div>
          <div class="col-lg-6 mb-4">
            <h2 class="mb-3">The Right People for the Job</h2>
            <p>
              The success of any project relies on the competence and dedication
              of the workforce. Velcorix specializes in providing highly
              skilled, certified professionals for the oil & gas, petrochemical,
              and construction sectors.
            </p>
            <p>
              We handle the entire lifecycle of manpower supplyÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Âfrom recruitment
              and vetting to visa processing and logisticsÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Âso you can focus on
              execution.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sub-Service Menu (Card Grid) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="section-title text-center mb-5">
          <h2>Our Manpower Divisions</h2>
          <p>Specialized teams tailored to your project requirements.</p>
        </div>
        <div class="row g-4">
          <!-- Card 1: Shutdown -->
          <div class="col-md-6 col-lg-3">
            <a
              href="/services/manpower-shutdown"
              class="text-decoration-none text-dark"
            >
              <div
                class="service-card text-center h-100 bg-white p-4 rounded shadow-sm border-0 transition-hover"
              >
                <div class="service-icon mb-3">
                  <i class="fas fa-calendar-times fa-3x text-primary"></i>
                </div>
                <h3 class="h5 fw-bold">Shutdown Manpower</h3>
                <p class="text-muted small">
                  Experienced crews for plant turnarounds and maintenance
                  outages.
                </p>
              </div>
            </a>
          </div>

          <!-- Card 2: Pre-commissioning -->
          <div class="col-md-6 col-lg-3">
            <a
              href="/services/manpower-precomm"
              class="text-decoration-none text-dark"
            >
              <div
                class="service-card text-center h-100 bg-white p-4 rounded shadow-sm border-0 transition-hover"
              >
                <div class="service-icon mb-3">
                  <i class="fas fa-clipboard-check fa-3x text-primary"></i>
                </div>
                <h3 class="h5 fw-bold">Pre-commissioning</h3>
                <p class="text-muted small">
                  Specialized teams for system testing, cleaning, and start-up.
                </p>
              </div>
            </a>
          </div>

          <!-- Card 3: Lifting -->
          <div class="col-md-6 col-lg-3">
            <a
              href="/services/manpower-lifting"
              class="text-decoration-none text-dark"
            >
              <div
                class="service-card text-center h-100 bg-white p-4 rounded shadow-sm border-0 transition-hover"
              >
                <div class="service-icon mb-3">
                  <i class="fas fa-arrows-alt-v fa-3x text-primary"></i>
                </div>
                <h3 class="h5 fw-bold">Lifting Manpower</h3>
                <p class="text-muted small">
                  Certified riggers and crane operators for heavy lifting.
                </p>
              </div>
            </a>
          </div>

          <!-- Card 4: HAC -->
          <div class="col-md-6 col-lg-3">
            <a href="/services/manpower-hac" class="text-decoration-none text-dark">
              <div
                class="service-card text-center h-100 bg-white p-4 rounded shadow-sm border-0 transition-hover"
              >
                <div class="service-icon mb-3">
                  <i class="fas fa-fan fa-3x text-primary"></i>
                </div>
                <h3 class="h5 fw-bold">HAC Manpower</h3>
                <p class="text-muted small">
                  HVAC technicians for industrial climate control systems.
                </p>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Typical Applications -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
          <h2>Typical Real-World Applications</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-hard-hat"></i>
              </div>
              <h4>Construction Sites</h4>
              <p class="small text-muted mb-0">
                General and specialized labor for civil and mechanical works.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-cogs"></i>
              </div>
              <h4>Industrial Plants</h4>
              <p class="small text-muted mb-0">
                Staffing for daily operations and routine maintenance.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-ship"></i>
              </div>
              <h4>Offshore Projects</h4>
              <p class="small text-muted mb-0">
                BOSIET certified personnel for marine environments.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-solar-panel"></i>
              </div>
              <h4>Renewable Energy</h4>
              <p class="small text-muted mb-0">
                Technicians for solar and wind farm installations.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capability Details (How We Do It) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-6">
            <h2 class="mb-4 fw-bold">Why Choose Velcorix?</h2>
            <div class="bg-white p-4 rounded shadow-sm">
              <p class="text-muted">
                We differ from standard recruitment agencies by providing
                technical leadership and support.
              </p>
              <ul class="list-unstyled">
                <li class="mb-3 d-flex align-items-start">
                  <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                  <div>
                    <strong>Vetting Process:</strong> Rigorous trade tests to
                    verify skills before deployment.
                  </div>
                </li>
                <li class="mb-3 d-flex align-items-start">
                  <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                  <div>
                    <strong>Welfare:</strong> Commitment to ethical labor
                    practices ensuring a motivated workforce.
                  </div>
                </li>
                <li class="mb-3 d-flex align-items-start">
                  <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                  <div>
                    <strong>Flexibility:</strong> Ability to scale up or down
                    rapidly based on project needs.
                  </div>
                </li>
              </ul>
            </div>
          </div>
          <div class="col-lg-6">
            <img
              src="/assets/images/services/DSC_2414.JPG"
              alt="Velcorix Capabilities"
              class="img-fluid rounded shadow w-100"
              onerror="this.src='https://placehold.co/600x400?text=Why+Choose+Us'"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Compliance & Support -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
          <h2>Compliance Standards</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
            <div
              class="bg-white p-3 rounded shadow-sm h-100 text-center border"
            >
              <i class="fas fa-file-invoice text-primary mb-3 fa-2x"></i>
              <h6 class="fw-bold">Labor Law</h6>
              <p class="small text-muted mb-0">
                Full compliance with UAE labor regulations.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div
              class="bg-white p-3 rounded shadow-sm h-100 text-center border"
            >
              <i class="fas fa-user-check text-primary mb-3 fa-2x"></i>
              <h6 class="fw-bold">ISO 45001</h6>
              <p class="small text-muted mb-0">
                Occupational health and safety management systems.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div
              class="bg-white p-3 rounded shadow-sm h-100 text-center border"
            >
              <i class="fas fa-heartbeat text-primary mb-3 fa-2x"></i>
              <h6 class="fw-bold">Insurance</h6>
              <p class="small text-muted mb-0">
                Comprehensive medical and workmen's compensation.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div
              class="bg-white p-3 rounded shadow-sm h-100 text-center border"
            >
              <i class="fas fa-hands-helping text-primary mb-3 fa-2x"></i>
              <h6 class="fw-bold">Support</h6>
              <p class="small text-muted mb-0">
                24/7 PRO and administrative support for staff.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section text-center text-white">
      <div class="container">
        <h2 class="cta-heading">Build with Confidence</h2>
        <p class="cta-subtext">
          Partner with Velcorix for your project manpower needs.
        </p>
        <a href="/contact" class="btn btn-primary btn-lg mt-3"
          >Contact Us Today</a
        >
      </div>
      <div class="footer-divider"></div>
    </section>

    <!-- Footer -->
</BaseLayout>

