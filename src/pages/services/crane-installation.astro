---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Crane Installation - Velcorix Services" description="Expert crane installation and maintenance services in UAE. Velcorix specializes in the erection, dismantling, and load testing of tower cranes and EOT cranes.">
<!-- Header (Hero) -->
    <PageHeader 
      title="Crane Installation Services" 
      subtitle="Safe and Precise Erection of Lifting Equipment" 
      bgImage="/assets/images/rentals/cranes-2.jpg" 
    />

    <!-- Overview (Intro) -->
    <section class="section-padding">
      <div class="container">
        <div class="row">
          <div class="col-lg-6">
            <img
              src="/assets/images/rentals/cranes.webp"
              class="img-fluid shadow intro-image"
              alt="Crane Installation"
              onerror="this.src='https://placehold.co/800x400?text=Crane+Installation'"
            />
          </div>
          <div class="col-lg-6 mb-4">
            <h2 class="mb-3">Lifting Your Projects Higher</h2>
            <p>
              The installation of tower cranes and overhead (EOT) cranes requires a unique blend of structural engineering, mechanical precision, and rigorous safety discipline. Velcorix is a premier provider of crane erection, climbing, dismantling, and maintenance services.
            </p>
            <p>
              Our certified teams ensure that your lifting assets are installed correctly, load-tested comprehensively, and certified for safe operation, whether on a high-rise construction site or a busy factory floor.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included (Key Offerings) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="section-title">
          <h2>Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Erection & Dismantling</h5>
                <p class="text-muted mb-0">Complete assembly and disassembly of Tower and EOT cranes.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Climbing / Jumping</h5>
                <p class="text-muted mb-0">Safe height extension of tower cranes as buildings rise.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Commissioning</h5>
                <p class="text-muted mb-0">Load testing and functional checks to manufacturer specifications.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
             <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Maintenance</h5>
                <p class="text-muted mb-0">Preventive maintenance contracts and 24/7 breakdown support.</p>
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- Typical Applications -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
          <h2>Typical Real-World Applications</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-building"></i>
              </div>
              <h4>Construction</h4>
              <p class="small text-muted mb-0">
                Tower cranes for high-rise residential and commercial towers.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-industry"></i>
              </div>
              <h4>Industrial</h4>
              <p class="small text-muted mb-0">
                Installation of EOT cranes in manufacturing plants and workshops.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-ship"></i>
              </div>
              <h4>Ports & Marine</h4>
              <p class="small text-muted mb-0">
                Erection of gantry cranes and ship-to-shore loaders.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-truck-loading"></i>
              </div>
              <h4>Logistics</h4>
              <p class="small text-muted mb-0">
                 Overhead systems for warehousing and material handling.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capability Details (How We Do It) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="mb-4 fw-bold">Capability Details</h2>
                <div class="bg-white p-4 rounded shadow-sm">
                   <p class="text-muted">
                    We bring together the right equipment and the right people for heavy lifting operations.
                   </p>
                   <ul class="list-unstyled">
                      <li class="mb-3 d-flex align-items-start">
                        <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                        <div>
                          <strong>Certified Team:</strong> All riggers and supervisors are third-party certified for lifting operations.
                        </div>
                      </li>
                      <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Method Statements:</strong> Detailed lifting plans and risk assessments for every installation.
                         </div>
                       </li>
                       <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Tooling:</strong> Specialized hydraulic torque wrenches and alignment tools for precise assembly.
                         </div>
                       </li>
                   </ul>
                </div>
            </div>
            <div class="col-lg-6">
                 <img src="/assets/images/services/DSC_2334.JPG" alt="Crane Installation" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Crane+Team'">
            </div>
        </div>
      </div>
    </section>

    <!-- Compliance & Support -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
            <h2>Compliance Standards</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-check-square text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Load Testing</h6>
                <p class="small text-muted mb-0">Proof load testing with certified water bags or weights.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-file-contract text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">DAC/Municipality</h6>
                <p class="small text-muted mb-0">Approvals from local regulatory bodies.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-ruler-combined text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Alignment</h6>
                <p class="small text-muted mb-0">Laser alignment of crane rails for smooth operation.</p>
             </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section text-center text-white">
      <div class="container">
        <h2 class="cta-heading">Lift with Safety</h2>
        <p class="cta-subtext">
          Ensure your heavy equipment is installed by experts.
        </p>
        <a href="/contact" class="btn btn-primary btn-lg mt-3"
          >Schedule Installation</a
        >
      </div>
      <div class="footer-divider"></div>
    </section>

    <!-- Footer -->
</BaseLayout>

