---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Downstream Services - Velcorix Services" description="Comprehensive downstream services for refineries and petrochemical plants in UAE. Velcorix provides turnaround support, tank services, and piping maintenance.">
<!-- Header (Hero) -->
    <PageHeader 
      title="Oil & Gas Downstream" 
      subtitle="Refining and Distribution Operational Support" 
      bgImage="/assets/images/services/DSC_2334.JPG" 
    />

    <!-- Overview (Intro) -->
    <section class="section-padding">
      <div class="container">
        <div class="row">
          <div class="col-lg-6">
            <img
              src="/assets/images/services/DSC_2335.JPG"
              class="img-fluid shadow intro-image"
              alt="Downstream Services"
              onerror="this.src='https://placehold.co/800x400?text=Downstream+Services'"
            />
          </div>
          <div class="col-lg-6 mb-4">
            <h2 class="mb-3">Refining & Distribution</h2>
            <p>
              Maintaining efficiency in downstream operations is essential for profitability. Velcorix offers specialized maintenance and support services for refineries, processing plants, and distribution networks.
            </p>
            <p>
              We focus on minimizing downtime during turnarounds and ensuring that all process equipment operates at peak efficiency through rigorous maintenance and inspection programs.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included (Key Offerings) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="section-title">
          <h2>Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Turnaround Support</h5>
                <p class="text-muted mb-0">Comprehensive planning and manpower for plant shutdowns.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Tank Services</h5>
                <p class="text-muted mb-0">Cleaning, inspection (API 653), and repair of storage tanks.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Catalyst Handling</h5>
                <p class="text-muted mb-0">Specialized loading and unloading of reactor catalysts.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
             <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Piping & Mechanical</h5>
                <p class="text-muted mb-0">Fabrication, modification, and repair of process piping.</p>
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- Typical Applications -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
          <h2>Typical Real-World Applications</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-industry"></i>
              </div>
              <h4>Refineries</h4>
              <p class="small text-muted mb-0">
                Crude distillation unit maintenance.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-gas-pump"></i>
              </div>
              <h4>Terminals</h4>
              <p class="small text-muted mb-0">
                Product storage and loading arm maintenance.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-flask"></i>
              </div>
              <h4>Chemical Plants</h4>
              <p class="small text-muted mb-0">
                Process vessel cleaning and inspection.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-truck-moving"></i>
              </div>
              <h4>Pipelines</h4>
              <p class="small text-muted mb-0">
                 Pigging support for product transfer lines.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capability Details (How We Do It) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="mb-4 fw-bold">Capability Details</h2>
                <div class="bg-white p-4 rounded shadow-sm">
                   <p class="text-muted">
                    Our downstream services are executed with a focus on minimizing asset downtime and maximizing operational safety.
                   </p>
                   <ul class="list-unstyled">
                      <li class="mb-3 d-flex align-items-start">
                        <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                        <div>
                          <strong>Turnaround Management:</strong> Proven methodologies for planning and executing complex plant shutdowns within tight windows.
                        </div>
                      </li>
                      <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Advanced NDT:</strong> Utilization of latest non-destructive testing technologies for corrosion mapping and flaw detection.
                         </div>
                       </li>
                       <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Safe Entry:</strong> Specialized confined space entry teams equipped with breathing apparatus and gas detection.
                         </div>
                       </li>
                   </ul>
                </div>
            </div>
            <div class="col-lg-6">
                 <img src="/assets/images/services/DSC_2414.JPG" alt="Downstream Capabilities" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Downstream+Capabilities'">
            </div>
        </div>
      </div>
    </section>

    <!-- Compliance & Support -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
            <h2>Compliance & Support</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-clipboard-list text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Process Safety</h6>
                <p class="small text-muted mb-0">Strict adherence to PSM (Process Safety Management) guidelines.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-certificate text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">API Standards</h6>
                <p class="small text-muted mb-0">Services compliant with API 653, 510, and 570.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-leaf text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Environment</h6>
                <p class="small text-muted mb-0">Waste management and spill containment protocols.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-hard-hat text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Qualified Crew</h6>
                <p class="small text-muted mb-0">Multi-skilled technicians certified for hazardous areas.</p>
             </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section text-center text-white">
      <div class="container">
        <h2 class="cta-heading">Optimize Refining Operations</h2>
        <p class="cta-subtext">
          Velcorix delivers the expertise you need for efficient plant maintenance.
        </p>
        <a href="/contact" class="btn btn-primary btn-lg mt-3"
          >Get in Touch</a
        >
      </div>
      <div class="footer-divider"></div>
    </section>

    <!-- Footer -->
</BaseLayout>

