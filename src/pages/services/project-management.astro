---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Project Management - Velcorix Services" description="Professional project management services in UAE for oil, gas, and construction sectors. Velcorix ensures expert oversight, cost control, and QHSE compliance for industrial projects.">
<!-- Header (Hero) -->
    <PageHeader 
      title="Project Management" 
      subtitle="Delivering excellence, on time and within budget" 
      bgImage="/assets/images/services/DSC_2414.JPG" 
    />

    <!-- Overview (Intro) -->
    <section class="section-padding">
      <div class="container">
        <div class="row">
          <div class="col-lg-6">
            <img
              src="/assets/images/services/DSC_2416.JPG"
              class="img-fluid shadow intro-image"
              alt="Project Management"
              onerror="this.src='https://placehold.co/800x400?text=Project+Management'"
            />
          </div>
          <div class="col-lg-6 mb-4">
            <h2 class="mb-3">Expert Project Oversight</h2>
            <p>
              Velcorix offers experienced project management teams that integrate seamlessly with your organization to oversee complex industrial projects. We ensure every phase ensures strict adherence to quality, safety, and timeline targets.
            </p>
            <p>
              From initial planning to final handover, our pmp-certified professionals utilize proven methodologies to mitigate risk and optimize resource allocation, ensuring successful project delivery in challenging environments.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included (Key Offerings) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="section-title">
          <h2>Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Resource Planning</h5>
                <p class="text-muted mb-0">Detailed scheduling of manpower, equipment, and material flows.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Cost Management</h5>
                <p class="text-muted mb-0">Budget estimation, tracking, and variance analysis.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Risk Management</h5>
                <p class="text-muted mb-0">Proactive identification and mitigation of project risks.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
             <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">QA & HSE Compliance</h5>
                <p class="text-muted mb-0">Ensuring all activities meet regulatory and internal standards.</p>
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- Typical Applications -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
          <h2>Typical Real-World Applications</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-hard-hat"></i>
              </div>
              <h4>Construction</h4>
              <p class="small text-muted mb-0">
                Turnkey management of civil and mechanical builds.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-cogs"></i>
              </div>
              <h4>Plant Shutdowns</h4>
              <p class="small text-muted mb-0">
                Time-critical management of maintenance turnarounds.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-truck-moving"></i>
              </div>
              <h4>Logistics</h4>
              <p class="small text-muted mb-0">
                Coordination of complex equipment mobilization.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-drafting-compass"></i>
              </div>
              <h4>Engineering</h4>
              <p class="small text-muted mb-0">
                 Oversight of FEED and detailed design phases.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capability Details (How We Do It) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="mb-4 fw-bold">Capability Details</h2>
                <div class="bg-white p-4 rounded shadow-sm">
                   <p class="text-muted">
                    We employ industry-leading standards to maintain transparency and control throughout the project lifecycle.
                   </p>
                   <ul class="list-unstyled">
                      <li class="mb-3 d-flex align-items-start">
                        <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                        <div>
                          <strong>Methodologies:</strong> Utilization of PMBOK and PRINCE2 frameworks adapted for the regional industrial context.
                        </div>
                      </li>
                      <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Digital Tools:</strong> Integration with Primavera P6 and MS Project for precise scheduling and critical path analysis.
                         </div>
                       </li>
                       <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Reporting:</strong> Regular, data-driven dashboards providing verified progress updates to stakeholders.
                         </div>
                       </li>
                   </ul>
                </div>
            </div>
            <div class="col-lg-6">
                 <img src="/assets/images/services/DSC_2418.JPG" alt="PM Capabilities" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=PM+Capabilities'">
            </div>
        </div>
      </div>
    </section>

    <!-- Compliance & Support -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
            <h2>Compliance & Support</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-user-tie text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Certified Pros</h6>
                <p class="small text-muted mb-0">Teams led by PMP and Prince2 certified managers.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-file-contract text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Contract Mgmt</h6>
                <p class="small text-muted mb-0">Expert administration of FIDIC and other standard contract forms.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-chart-bar text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Cost Control</h6>
                <p class="small text-muted mb-0">Rigorous cost tracking to prevent budget overruns.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-handshake text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Stakeholder Alignment</h6>
                <p class="small text-muted mb-0">Ensuring clear communication between clients, contractors, and vendors.</p>
             </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section text-center text-white">
      <div class="container">
        <h2 class="cta-heading">Streamline Your Project</h2>
        <p class="cta-subtext">
          Engage Velcorix for professional project management services.
        </p>
        <a href="/contact" class="btn btn-primary btn-lg mt-3"
          >Get Started</a
        >
      </div>
      <div class="footer-divider"></div>
    </section>

    <!-- Footer -->
</BaseLayout>

