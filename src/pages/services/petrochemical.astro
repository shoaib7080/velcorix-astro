---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Petrochemical Services - Velcorix Services" description="Expert petrochemical services and plant maintenance in UAE. Velcorix provides heat exchanger services, vessel repairs, and turnaround support for chemical processing plants.">
<!-- Header (Hero) -->
    <PageHeader 
      title="Petrochemical Services" 
      subtitle="Specialized Support for Chemical Processing Plants" 
      bgImage="/assets/images/services/DSC_2359.JPG" 
    />

    <!-- Overview (Intro) -->
    <section class="section-padding">
      <div class="container">
        <div class="row">
          <div class="col-lg-6">
            <img
              src="/assets/images/services/DSC_2407.JPG"
              class="img-fluid shadow intro-image"
              alt="Petrochemical Services"
              onerror="this.src='https://placehold.co/800x400?text=Chemical+Plant+Services'"
            />
          </div>
          <div class="col-lg-6 mb-4">
            <h2 class="mb-3">Plant Integrity & Efficiency</h2>
            <p>
              The petrochemical industry demands the highest levels of safety and precision. Velcorix provides a comprehensive range of mechanical and technical services designed to maintain the integrity of critical process equipment.
            </p>
            <p>
              From heat exchanger maintenance to complex vessel repairs, our experienced teams deliver results that minimize downtime and extend asset life.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included (Key Offerings) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="section-title">
          <h2>Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Heat Exchanger Services</h5>
                <p class="text-muted mb-0">Bundle extraction, high-pressure cleaning, and re-tubing.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Vessel Repair</h5>
                <p class="text-muted mb-0">Internal weld overlay, patch repairs, and nozzle replacement.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Insulation & Scaffolding</h5>
                <p class="text-muted mb-0">Thermal insulation for piping/vessels and safe access solutions.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
             <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Civil Works</h5>
                <p class="text-muted mb-0">Equipment foundation repair and specialized grouting.</p>
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- Typical Applications -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
          <h2>Typical Real-World Applications</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-random"></i>
              </div>
              <h4>Turnarounds</h4>
              <p class="small text-muted mb-0">
                Major maintenance during scheduled plant shutdowns.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-temperature-high"></i>
              </div>
              <h4>Heaters</h4>
              <p class="small text-muted mb-0">
                Maintenance of fired heaters and furnaces.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-vial"></i>
              </div>
              <h4>Columns</h4>
              <p class="small text-muted mb-0">
                Tray replacement and internal inspection of distillation columns.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-compress-arrows-alt"></i>
              </div>
              <h4>Cooling Towers</h4>
              <p class="small text-muted mb-0">
                 Structural repair and fill replacement.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capability Details (How We Do It) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="mb-4 fw-bold">Capability Details</h2>
                <div class="bg-white p-4 rounded shadow-sm">
                   <p class="text-muted">
                    We bring specialized tools and experienced leadership to challenging petrochemical projects.
                   </p>
                   <ul class="list-unstyled">
                      <li class="mb-3 d-flex align-items-start">
                        <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                        <div>
                          <strong>Automated Tools:</strong> Use of automated bundle pullers and high-pressure cleaning systems to improve safety and speed.
                        </div>
                      </li>
                      <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Material Handling:</strong> Expertise in handling exotic alloys often found in chemical plants.
                         </div>
                       </li>
                       <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Integrated Teams:</strong> Providing multi-disciplinary teams (mechanical, civil, insulation) to minimize interface coordination.
                         </div>
                       </li>
                   </ul>
                </div>
            </div>
            <div class="col-lg-6">
                 <img src="/assets/images/services/DSC_2408.JPG" alt="Petrochemical Capabilities" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Petrochem+Capabilities'">
            </div>
        </div>
      </div>
    </section>

    <!-- Compliance & Support -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
            <h2>Compliance & Support</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-exclamation-triangle text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">HazMat Handling</h6>
                <p class="small text-muted mb-0">Protocol for working with hazardous chemicals.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-check-square text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Quality Control</h6>
                <p class="small text-muted mb-0">Detailed ITPs (Inspection and Test Plans) for all repairs.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-people-carry text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Emergency Support</h6>
                <p class="small text-muted mb-0">24/7 call-out for unplanned outages.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-tools text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Tooling</h6>
                <p class="small text-muted mb-0">Complete inventory of spark-proof and hydraulic tools.</p>
             </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section text-center text-white">
      <div class="container">
        <h2 class="cta-heading">Secure Your Production</h2>
        <p class="cta-subtext">
          Trust Velcorix for expert petrochemical plant maintenance.
        </p>
        <a href="/contact" class="btn btn-primary btn-lg mt-3"
          >Get a Quote</a
        >
      </div>
      <div class="footer-divider"></div>
    </section>

    <!-- Footer -->
</BaseLayout>

