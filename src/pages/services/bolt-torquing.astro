---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Bolt Torquing - Velcorix Services" description="Expert hydraulic bolt torquing services in UAE. Velcorix provides precision tightening for leak-free flange connections using calibrated tools and certified technicians.">
<!-- Header (Hero) -->
    <PageHeader 
      title="Bolt Torquing Services" 
      subtitle="Precision Hydraulic Tightening for Critical Joints" 
      bgImage="/assets/images/services/DSC_2415.JPG" 
    />

    <!-- Overview (Intro) -->
    <section class="section-padding">
      <div class="container">
        <div class="row">
          <div class="col-lg-6">
            <img
              src="/assets/images/services/bolt-torque-2.webp"
              class="img-fluid shadow intro-image"
              alt="Bolt Torquing Services"
              onerror="this.src='https://placehold.co/800x400?text=Torquing+Services'"
            />
          </div>
          <div class="col-lg-6 mb-4">
            <h2 class="mb-3">Leak-Free Flange Connections</h2>
            <p>
              The integrity of any piping system relies on the quality of its bolted connections. Velcorix provides expert hydraulic bolt torquing services to ensure that every flange is tightened to the precise specification required for leak-free operation.
            </p>
            <p>
              We utilize state-of-the-art hydraulic torque wrenches and calibrated pumping units, operated by certified technicians who understand the importance of controlled bolting.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included (Key Offerings) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="section-title">
          <h2>Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Low Profile & Square Drive</h5>
                <p class="text-muted mb-0">Use of varied tools for restricted access and standard applications.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Joint Integrity Mgmt</h5>
                <p class="text-muted mb-0">Complete flange management including tagging and database logging.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Manpower Supply</h5>
                <p class="text-muted mb-0">Provision of certified bolting technicians and supervisors.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
             <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Equipment Rental</h5>
                <p class="text-muted mb-0">Daily or monthly rental of calibrated torque tools.</p>
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- Typical Applications -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
          <h2>Typical Real-World Applications</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-network-wired"></i>
              </div>
              <h4>Pipeline Flanges</h4>
              <p class="small text-muted mb-0">
                Assembly of high-pressure flow lines.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-cogs"></i>
              </div>
              <h4>Exchangers</h4>
              <p class="small text-muted mb-0">
                Re-boxing of girth flanges and channel covers.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-columns"></i>
              </div>
              <h4>Vessels & Reactors</h4>
              <p class="small text-muted mb-0">
                Manway door securement and nozzle connections.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-wind"></i>
              </div>
              <h4>Structural Bolts</h4>
              <p class="small text-muted mb-0">
                 Tightening of large structural foundations.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capability Details (How We Do It) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="mb-4 fw-bold">Capability Details</h2>
                <div class="bg-white p-4 rounded shadow-sm">
                   <p class="text-muted">
                    Precision is our priority. We follow strict procedures to ensure even load distribution across all fasteners.
                   </p>
                   <ul class="list-unstyled">
                      <li class="mb-3 d-flex align-items-start">
                        <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                        <div>
                          <strong>Calibration:</strong> All torque wrenches are calibrated to international standards (NIST traceable).
                        </div>
                      </li>
                      <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Calculation:</strong> We use advanced software to calculate the precise torque values based on friction factors and bolt grade.
                         </div>
                       </li>
                       <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Procedure:</strong> Strict adherence to multi-pass tightening sequences (Star Pattern) to prevent localized gasket crushing.
                         </div>
                       </li>
                   </ul>
                </div>
            </div>
            <div class="col-lg-6">
                 <img src="/assets/images/services/bolt-torque.jpg" alt="Torquing Capabilities" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Torquing+Capabilities'">
            </div>
        </div>
      </div>
    </section>

    <!-- Compliance & Support -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
            <h2>Compliance & Support</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-scroll text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">ASME PCC-1</h6>
                <p class="small text-muted mb-0">Full compliance with Guidelines for Pressure Boundary Bolted Flange Joint Assembly.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-user-graduate text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">ECITB Certified</h6>
                <p class="small text-muted mb-0">Technicians trained and certified to ECITB MJI standards.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-file-alt text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Reporting</h6>
                <p class="small text-muted mb-0">Comprehensive joint completion reports for QA/QC handover.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-hard-hat text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Safety First</h6>
                <p class="small text-muted mb-0">Rigorous inspection of hoses and pumps before every shift.</p>
             </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section text-center text-white">
      <div class="container">
        <h2 class="cta-heading">Ensure Joint Integrity</h2>
        <p class="cta-subtext">
          Eliminate leaks with Velcorix's professional bolt torquing services.
        </p>
        <a href="/contact" class="btn btn-primary btn-lg mt-3"
          >Get a Quote</a
        >
      </div>
      <div class="footer-divider"></div>
    </section>

    <!-- Footer -->
</BaseLayout>

