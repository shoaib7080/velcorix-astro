---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Pre-commissioning - Velcorix Services" description="Comprehensive oil and gas pre-commissioning services in UAE. Velcorix provides air blowing, leak testing (N2/He), chemical cleaning, and system preservation for industrial readiness.">
<!-- Header (Hero) -->
    <PageHeader 
      title="Oil & Gas Pre-Commissioning Services" 
      subtitle="Systematic pre-commissioning support to verify mechanical completion, ensure system integrity, and prepare oil and gas facilities." 
      bgImage="/assets/images/services/DSC_2470.JPG" 
    />

    <!-- Overview (Intro) -->
    <section class="section-padding">
      <div class="container">
        <div class="row">
          <div class="col-lg-6">
            <img
              src="/assets/images/services/DSC_2510.JPG"
              class="img-fluid shadow intro-image"
              alt="Pre-commissioning"
              onerror="this.src='https://placehold.co/800x400?text=Pre-commissioning'"
            />
          </div>
          <div class="col-lg-6 mb-4">
            <h2 class="mb-3">Where Construction Ends and Operational Risk Begins</h2>
            <p>
             Pre-commissioning is the critical transition phase between construction and commissioning. Errors at this stage result in delayed startups, equipment damage, safety incidents, and long-term reliability issues.
            </p>
            <p>
              Velcorix provides specialized oil & gas pre-commissioning services to ensure systems are mechanically complete, clean, tested, and ready for commissioning, in full compliance with project specifications and regulatory requirements.
            </p>
            <p>
              Our role is to verify readiness, eliminate latent defects, and de-risk startup before hydrocarbons are introduced.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Scope / WhatÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢s Included (Key Offerings) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="section-title">
          <h2>Our Pre-Commissioning Scope</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Air Blowing & Drying</h5>
                <p class="text-muted mb-0">Removal of debris and moisture to specified dew points.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Leak Testing (N2/He)</h5>
                <p class="text-muted mb-0">High-sensitivity testing using Nitrogen and Helium mixtures.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Chemical Cleaning/Flushing</h5>
                <p class="text-muted mb-0">Degreasing and pickling to achieve desired surface passivity.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
             <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Pressure Testing & Integrity Assurance</h5>
                <p class="text-muted mb-0">Hydrostatic and pneumatic pressure testing to ensure system integrity.</p>
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
    </section>

    <!-- Typical Applications -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
          <h2>Typical Pre-Commissioning Engagements</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-network-wired"></i>
              </div>
              <h4>Pipelines</h4>
              <p class="small text-muted mb-0">
                Dewatering and drying of cross-country pipelines.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-industry"></i>
              </div>
              <h4>Process Plants</h4>
              <p class="small text-muted mb-0">
                Steam blowing of critical steam lines in refineries.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-database"></i>
              </div>
              <h4>Storage Tanks</h4>
              <p class="small text-muted mb-0">
                Hydrostatic testing and calibration.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-ship"></i>
              </div>
              <h4>Offshore</h4>
              <p class="small text-muted mb-0">
                Tightness testing of topside process arrangements.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capability Details (How We Do It) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h2 class="mb-4 fw-bold">Why Clients Choose Velcorix</h2>
                <div class="bg-white p-4 rounded shadow-sm">
                   <p class="text-muted">
                    We deploy specialized, high-performance equipment and skilled technicians to execute pre-commissioning tasks efficiently.
                   </p>
                   <ul class="list-unstyled">
                      <li class="mb-3 d-flex align-items-start">
                        <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                        <div>
                          <strong>Specialized Equipment:</strong> Fleet of high-volume oil-free compressors, booster pumps, and cryogenic vaporizers.
                        </div>
                      </li>
                      <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Leak Detection:</strong> Usage of mass spectrometer leak detectors for pinpoint accuracy in N2/He testing.
                         </div>
                       </li>
                       <li class="mb-3 d-flex align-items-start">
                         <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                         <div>
                           <strong>Data Logging:</strong> Real-time digital recording of pressure and temperature for verifiable compliance reports.
                         </div>
                       </li>
                   </ul>
                </div>
            </div>
            <div class="col-lg-6">
                 <img src="/assets/images/services/DSC_2545.JPG" alt="Pre-comm Capabilities" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Pre-comm+Capabilities'">
            </div>
        </div>
      </div>
    </section>

    <!-- Compliance & Support -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
            <h2>Compliance & Support</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-clipboard-check text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Validation</h6>
                <p class="small text-muted mb-0">Detailed test packs and punch list management.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-leaf text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Environmental</h6>
                <p class="small text-muted mb-0">Safe disposal of test mediums and flushing chemicals.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-exclamation-triangle text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Safety</h6>
                <p class="small text-muted mb-0">Strict exclusion zones and high-pressure safety protocols.</p>
             </div>
          </div>
          <div class="col-md-3">
             <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
                <i class="fas fa-clock text-primary mb-3 fa-2x"></i>
                <h6 class="fw-bold">Availability</h6>
                <p class="small text-muted mb-0">Rapid mobilization to meet critical path schedules.</p>
             </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section text-center text-white">
      <div class="container">
        <h2 class="cta-heading">Ensure System Integrity</h2>
        <p class="cta-subtext">
          Trust Velcorix for your critical pre-commissioning requirements.
        </p>
        <a href="/contact" class="btn btn-primary btn-lg mt-3"
          >Talk to an advisor</a
        >
      </div>
      <div class="footer-divider"></div>
    </section>

    <!-- Footer -->
</BaseLayout>

