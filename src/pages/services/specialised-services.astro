---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Specialised Services - Velcorix Services" description="Comprehensive specialized services in UAE for Upstream, Downstream, Petrochemical, and Offshore sectors. Velcorix delivers engineered solutions to enhance industrial safety and efficiency.">
<!-- Header (Hero) -->
    <PageHeader 
      title="Specialised Services" 
      subtitle="Tailored Solutions for Energy & Industry" 
      bgImage="/assets/images/services/DSC_2407.JPG" 
    />

    <!-- Overview (Intro) -->
    <section class="section-padding">
      <div class="container">
        <div class="row">
          <div class="col-lg-6">
            <img
              src="/assets/images/services/DSC_2408.JPG"
              class="img-fluid shadow intro-image"
              alt="Services Overview"
              onerror="this.src='https://placehold.co/800x400?text=Specialised+Services'"
            />
          </div>
          <div class="col-lg-6 mb-4">
            <h2 class="mb-3">Expertise Across Every Sector</h2>
            <p>
              Velcorix understands that the needs of an offshore platform differ
              vastly from those of a petrochemical refinery. Our specialized
              services are segmented to provide deep domain expertise relevant
              to each sector of the energy industry.
            </p>
            <p>
              Whether exploring new fields upstream or refining products
              downstream, we deliver engineered solutions that enhance safety,
              efficiency, and productivity.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Sub-Service Menu (Card Grid) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="section-title text-center mb-5">
          <h2>Our Service Sectors</h2>
          <p>Dedicated divisions for focused industrial support.</p>
        </div>
        <div class="row g-4">
          <!-- Card 1: Upstream -->
          <div class="col-md-6 col-lg-3">
            <a href="/services/upstream" class="text-decoration-none text-dark">
              <div
                class="service-card text-center h-100 bg-white p-4 rounded shadow-sm border-0 transition-hover"
              >
                <div class="service-icon mb-3">
                  <i class="fas fa-oil-well fa-3x text-primary"></i>
                </div>
                <h3 class="h5 fw-bold">Oil & Gas Upstream</h3>
                <p class="text-muted small">
                  Exploration, drilling support, and field development services.
                </p>
              </div>
            </a>
          </div>

          <!-- Card 2: Downstream -->
          <div class="col-md-6 col-lg-3">
            <a href="/services/downstream" class="text-decoration-none text-dark">
              <div
                class="service-card text-center h-100 bg-white p-4 rounded shadow-sm border-0 transition-hover"
              >
                <div class="service-icon mb-3">
                  <i class="fas fa-industry fa-3x text-primary"></i>
                </div>
                <h3 class="h5 fw-bold">Oil & Gas Downstream</h3>
                <p class="text-muted small">
                  Maintenance and shutdowns for refineries and processing
                  plants.
                </p>
              </div>
            </a>
          </div>

          <!-- Card 3: Petrochemical -->
          <div class="col-md-6 col-lg-3">
            <a href="/services/petrochemical" class="text-decoration-none text-dark">
              <div
                class="service-card text-center h-100 bg-white p-4 rounded shadow-sm border-0 transition-hover"
              >
                <div class="service-icon mb-3">
                  <i class="fas fa-flask fa-3x text-primary"></i>
                </div>
                <h3 class="h5 fw-bold">Petrochemical</h3>
                <p class="text-muted small">
                  Specialized services for chemical plants and fertilizer units.
                </p>
              </div>
            </a>
          </div>

          <!-- Card 4: Offshore -->
          <div class="col-md-6 col-lg-3">
            <a href="/services/offshore" class="text-decoration-none text-dark">
              <div
                class="service-card text-center h-100 bg-white p-4 rounded shadow-sm border-0 transition-hover"
              >
                <div class="service-icon mb-3">
                  <i class="fas fa-ship fa-3x text-primary"></i>
                </div>
                <h3 class="h5 fw-bold">Offshore</h3>
                <p class="text-muted small">
                  Marine services, platform maintenance, and subsea support.
                </p>
              </div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Typical Applications -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
          <h2>Typical Real-World Applications</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-bacon"></i>
              </div>
              <h4>Pipeline Services</h4>
              <p class="small text-muted mb-0">
                Pigging, cleaning, and inspection of transmission lines.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-drum-steelpan"></i>
              </div>
              <h4>Tank Maintenance</h4>
              <p class="small text-muted mb-0">
                Storage tank cleaning, repair, and calibration.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-network-wired"></i>
              </div>
              <h4>Skid Packages</h4>
              <p class="small text-muted mb-0">
                Design and fabrication of process skids.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-tools"></i>
              </div>
              <h4>Rotating Equip.</h4>
              <p class="small text-muted mb-0">
                Overhaul of pumps, compressors, and turbines.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capability Details (How We Do It) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-6">
            <h2 class="mb-4 fw-bold">Our Approach</h2>
            <div class="bg-white p-4 rounded shadow-sm">
              <p class="text-muted">
                We deliver value through a combination of technical excellence
                and local understanding.
              </p>
              <ul class="list-unstyled">
                <li class="mb-3 d-flex align-items-start">
                  <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                  <div>
                    <strong>Engineering First:</strong> All solutions are backed
                    by rigorous engineering calculations.
                  </div>
                </li>
                <li class="mb-3 d-flex align-items-start">
                  <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                  <div>
                    <strong>Safety Culture:</strong> Behavior-based safety
                    programs integrated into every project.
                  </div>
                </li>
                <li class="mb-3 d-flex align-items-start">
                  <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                  <div>
                    <strong>Technology:</strong> Utilizing the latest diagnostic
                    and maintenance technologies.
                  </div>
                </li>
              </ul>
            </div>
          </div>
          <div class="col-lg-6">
            <img
              src="/assets/images/services/DSC_2415.JPG"
              alt="Velcorix Approach"
              class="img-fluid rounded shadow w-100"
              onerror="this.src='https://placehold.co/600x400?text=Our+Approach'"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Compliance & Support -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
          <h2>Compliance Standards</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
            <div
              class="bg-white p-3 rounded shadow-sm h-100 text-center border"
            >
              <i class="fas fa-certificate text-primary mb-3 fa-2x"></i>
              <h6 class="fw-bold">ISO 9001</h6>
              <p class="small text-muted mb-0">
                Quality Management Systems certified.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div
              class="bg-white p-3 rounded shadow-sm h-100 text-center border"
            >
              <i class="fas fa-leaf text-primary mb-3 fa-2x"></i>
              <h6 class="fw-bold">ISO 14001</h6>
              <p class="small text-muted mb-0">
                Environmental Management compliance.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div
              class="bg-white p-3 rounded shadow-sm h-100 text-center border"
            >
              <i class="fas fa-users-cog text-primary mb-3 fa-2x"></i>
              <h6 class="fw-bold">In-Country Value</h6>
              <p class="small text-muted mb-0">
                Committed to maximizing local content and ICV contribution.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div
              class="bg-white p-3 rounded shadow-sm h-100 text-center border"
            >
              <i class="fas fa-wrench text-primary mb-3 fa-2x"></i>
              <h6 class="fw-bold">OEM Partnership</h6>
              <p class="small text-muted mb-0">
                Authorized service center for leading equipment manufacturers.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section text-center text-white">
      <div class="container">
        <h2 class="cta-heading">Ready to Engage?</h2>
        <p class="cta-subtext">
          Contact us to discuss your specific requirements.
        </p>
        <a href="/contact" class="btn btn-primary btn-lg mt-3"
          >Get in Touch</a
        >
      </div>
      <div class="footer-divider"></div>
    </section>

    <!-- Footer -->
</BaseLayout>

