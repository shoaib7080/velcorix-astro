---
import PageHeader from '../../components/PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Engineering Construction - Velcorix Services" description="Civil and mechanical construction services for industrial infrastructure in the UAE. Velcorix delivers foundations, structural steel, equipment installation and piping works.">
<!-- Header (Hero) -->
    <PageHeader 
      title="Engineering Construction" 
      subtitle="Civil and Mechanical Works for Industrial Infrastructure" 
      bgImage="/assets/images/services/DSC_2326.JPG" 
    />

    <!-- Overview (Intro) -->
    <section class="section-padding">
      <div class="container">
        <div class="row">
          <div class="col-lg-6">
            <img
              src="/assets/images/services/DSC_2331.JPG"
              class="img-fluid shadow intro-image"
              alt="Engineering Construction"
              onerror="this.src='https://placehold.co/800x400?text=Engineering+Construction'"
            />
          </div>
          <div class="col-lg-6 mb-4">
            <h2 class="mb-3">Building Industrial Infrastructure</h2>
            <p>
              Industrial facilities depend on the groundwork beneath them ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â foundations that hold alignment under load, steelwork that carries the plant above it, and equipment set to tolerance the first time. Velcorix delivers civil and mechanical construction services for industrial infrastructure across the UAE.
            </p>
            <p>
              We work across the full package: civil and concrete works, structural steel fabrication and erection, mechanical equipment installation, and process and utility piping. Because we also operate our own rental fleet, the cranes, compressors, generators and welding equipment a package needs are available without waiting on a third party.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Scope / What's Included (Key Offerings) -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="section-title">
          <h2>Scope / What&rsquo;s Included</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Civil &amp; Concrete Works</h5>
                <p class="text-muted mb-0">Foundations, plinths, trenches and concrete structures for plant and equipment.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Structural Steel</h5>
                <p class="text-muted mb-0">Fabrication and erection of platforms, access structures and pipe racks.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Mechanical Installation</h5>
                <p class="text-muted mb-0">Setting, aligning and anchoring of static and rotating equipment.</p>
              </div>
            </div>
          </div>
          <div class="col-md-6">
            <div class="d-flex align-items-start">
              <i class="fas fa-circle text-primary mt-2 me-3" style="font-size: 0.5rem;"></i>
              <div>
                <h5 class="fw-bold mb-1">Piping Works</h5>
                <p class="text-muted mb-0">Fabrication, installation and support of process and utility piping.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Typical Applications -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
          <h2>Typical Real-World Applications</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-industry"></i>
              </div>
              <h4>Refineries</h4>
              <p class="small text-muted mb-0">
                Foundations, structures and equipment installation for process units.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-flask"></i>
              </div>
              <h4>Petrochemical</h4>
              <p class="small text-muted mb-0">
                Pipe racks, supports and mechanical works within operating plants.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-bolt"></i>
              </div>
              <h4>Power &amp; Utilities</h4>
              <p class="small text-muted mb-0">
                Civil and structural packages for generation and distribution assets.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-ship"></i>
              </div>
              <h4>Ports &amp; Marine</h4>
              <p class="small text-muted mb-0">
                Shore-side foundations, steelwork and equipment setting.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capability Details -->
    <section class="section-padding bg-light">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-lg-6">
            <h2 class="mb-4 fw-bold">Capability Details</h2>
            <div class="bg-white p-4 rounded shadow-sm">
              <p class="text-muted">
                Construction packages run to schedule when the trades, the plant and the paperwork move together.
              </p>
              <ul class="list-unstyled">
                <li class="mb-3 d-flex align-items-start">
                  <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                  <div>
                    <strong>Integrated Teams:</strong> Civil, structural and mechanical crews working to a single programme.
                  </div>
                </li>
                <li class="mb-3 d-flex align-items-start">
                  <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                  <div>
                    <strong>Method Statements:</strong> Documented work packs and risk assessments before mobilisation.
                  </div>
                </li>
                <li class="mb-3 d-flex align-items-start">
                  <i class="fas fa-check-circle text-primary mt-1 me-3"></i>
                  <div>
                    <strong>Plant &amp; Tooling:</strong> Cranes, compressors, generators and welding equipment from our own rental fleet.
                  </div>
                </li>
              </ul>
            </div>
          </div>
          <div class="col-lg-6">
            <img src="/assets/images/services/DSC_2345.JPG" alt="Engineering Construction Team" class="img-fluid rounded shadow w-100" onerror="this.src='https://placehold.co/600x400?text=Construction+Team'">
          </div>
        </div>
      </div>
    </section>

    <!-- How We Work -->
    <section class="section-padding">
      <div class="container">
        <div class="section-title">
          <h2>How We Work</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
            <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
              <i class="fas fa-ruler-combined text-primary mb-3 fa-2x"></i>
              <h6 class="fw-bold">Survey &amp; Setting Out</h6>
              <p class="small text-muted mb-0">Levels and reference points established before work begins.</p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
              <i class="fas fa-clipboard-check text-primary mb-3 fa-2x"></i>
              <h6 class="fw-bold">Inspection Points</h6>
              <p class="small text-muted mb-0">Dimensional and weld checks at agreed hold points.</p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
              <i class="fas fa-hard-hat text-primary mb-3 fa-2x"></i>
              <h6 class="fw-bold">Site Safety</h6>
              <p class="small text-muted mb-0">Permit-to-work discipline on live and shutdown sites alike.</p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="bg-white p-3 rounded shadow-sm h-100 text-center border">
              <i class="fas fa-folder-open text-primary mb-3 fa-2x"></i>
              <h6 class="fw-bold">Handover</h6>
              <p class="small text-muted mb-0">As-built records and documentation on completion.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="cta-section text-center text-white">
      <div class="container">
        <h2 class="cta-heading">Build on Solid Ground</h2>
        <p class="cta-subtext">
          Talk to us about your next civil or mechanical construction package.
        </p>
        <a href="/contact" class="btn btn-primary btn-lg mt-3"
          >Discuss Your Project</a
        >
      </div>
      <div class="footer-divider"></div>
    </section>

    <!-- Footer -->
</BaseLayout>

