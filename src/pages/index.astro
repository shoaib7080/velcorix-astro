  <!-- Safety, Quality & Compliance Section -->
  <section class="section-padding">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6 mb-4">
          <picture>
            <source
              type="image/webp"
              srcset="
                /assets/images/hero/optimized/DSC_2406-800.webp   800w,
                /assets/images/hero/optimized/DSC_2406-1200.webp 1200w
              "
              sizes="(max-width: 768px) 100vw, 600px"
            />
            <img
              src="/assets/images/hero/optimized/DSC_2406-800.jpg"
              alt="Safety and Quality"
              class="img-fluid rounded shadow"
              width="600"
              height="400"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
        <div class="col-lg-6">
          <h2 class="mb-4">Safety, Quality & Compliance</h2>
          <p class="lead mb-4">
            Velcorix operates with a strong focus on safety, quality, and
            industry compliance.
          </p>
          <p class="mb-4">
            Our trading products are sourced from certified manufacturers and aligned with applicable
            international standards and best practices to ensure safe and
            efficient project execution.
          </p>
          <ul class="list-unstyled">
            <li class="mb-2">
              <i class="fas fa-shield-alt text-primary me-2"></i>HSE-first mindset in product selection
            </li>
            <li class="mb-2">
              <i class="fas fa-certificate text-primary me-2"></i>Certified materials and equipment
            </li>
            <li class="mb-2">
              <i class="fas fa-file-contract text-primary me-2"></i>Documentation and full traceability
            </li>
          </ul>
        </div>
