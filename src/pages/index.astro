---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaSection from '../components/CtaSection.astro';

const tradingCategories = [
  {
    id: "mechanical-consumables",
    title: "Mechanical Consumables & Supplies",
    subtitle: "Hardware, PPE, Stationery & Welding",
    desc: "Quality industrial consumables, abrasives, certified personal protective equipment, welding torches, and essential site stationery.",
    image: "/assets/images/trading/hardware1.png",
    icon: "fas fa-tools",
    badge: "Consumables & Tools",
    highlights: ["Hardware & Tools", "Welding Supplies", "PPE Safety Gear", "Stationery Essentials"],
    link: "/trading#mechanical-consumables"
  },
  {
    id: "industrial-equipment",
    title: "Industrial Equipment Trading",
    subtitle: "Heavy Machinery & ATEX Systems",
    desc: "Certified ATEX explosion-proof systems, diesel power generators, lifting hoists, hydro jetting pumps, and H120 fire & blast barriers.",
    image: "/assets/images/trading/atex1.png",
    icon: "fas fa-industry",
    badge: "Certified Machinery",
    highlights: ["ATEX Hazardous Area", "Silent DG Generators", "Lifting & Winches", "H120 Blast Doors"],
    link: "/trading#industrial-equipment"
  },
  {
    id: "steel-metal-products",
    title: "Steel & Metal Products",
    subtitle: "Structural Sections & Plates",
    desc: "Mill-certified structural steel beams, channels, angles, high-yield mild steel plates, anti-slip chequered sheets, and floor gratings.",
    image: "/assets/images/trading/steel1.png",
    icon: "fas fa-cubes",
    badge: "Structural Metals",
    highlights: ["UB, UC & IPE Beams", "PFC & UPN Channels", "MS & Chequered Plates", "Electro-Forged Gratings"],
    link: "/trading#steel-metal-products"
  }
];

const mostTradedItems = [
  {
    name: "WD-40 Multi-Use Lubricant",
    category: "Hardware",
    image: "/assets/images/trading/hardware1.png",
    link: "/trading/hardware",
    desc: "Anti-rust lubricant and moisture displacer spray"
  },
  {
    name: "E7018 Welding Electrodes 3.2mm",
    category: "Welding",
    image: "/assets/images/products/WEILDING/weildingrod.avif",
    link: "/trading/welding-consumables",
    desc: "Low-hydrogen high-yield structural welding rods"
  },
  {
    name: "Personal Gas Monitor",
    category: "PPE Safety",
    image: "/assets/images/products/PPE/personal-gas-monitor.jpg",
    link: "/trading/ppe",
    desc: "Multi-gas detector for hazardous environments"
  },
  {
    name: "S3 Steel-Toe Safety Boots",
    category: "PPE Safety",
    image: "/assets/images/products/PPE/safety-shoes.webp",
    link: "/trading/ppe",
    desc: "Puncture & impact-resistant S3 work boots"
  },
  {
    name: "TIG Argon Torch Assembly",
    category: "Welding",
    image: "/assets/images/products/WEILDING/tigtorch.webp",
    link: "/trading/welding-consumables",
    desc: "Lincoln & ESAB compatible precision torch"
  },
  {
    name: "ATEX 4-Pin Plug & Socket",
    category: "ATEX Equipment",
    image: "/assets/images/products/ATEX/socket-male-female-4-pin.jpg",
    link: "/trading/atex",
    desc: "Explosion-proof hazardous area connectors"
  },
  {
    name: "SS 316L Ball-Lock Cable Ties",
    category: "ATEX Supplies",
    image: "/assets/images/products/ATEX/ss-cable-tie-pvc-coated-ball-lock-black-4-6x100-mm-ss-316l.jpg",
    link: "/trading/atex",
    desc: "Marine-grade PVC coated stainless steel ties"
  },
  {
    name: "Structural Steel Beams (UB / UC)",
    category: "Structural Steel",
    image: "/assets/images/products/STEEL/beams.jpeg",
    link: "/trading/structural-steel",
    desc: "Mill-certified heavy structural frame sections"
  },
  {
    name: "Chequered Floor Plates",
    category: "Structural Steel",
    image: "/assets/images/products/STEEL/chequered-plates.jpeg",
    link: "/trading/structural-steel",
    desc: "Anti-slip tread plates for platforms & walkways"
  },
  {
    name: "Face Shield Impact Guard",
    category: "PPE Safety",
    image: "/assets/images/products/PPE/face-shield-guard.jpg",
    link: "/trading/ppe",
    desc: "Polycarbonate impact visor with ratchet headgear"
  },
  {
    name: "Silent Diesel Generator Sets",
    category: "Equipment",
    image: "/assets/images/other/10kw-diesel-power-generator.jpg",
    link: "/trading/generators",
    desc: "Acoustic soundproof prime site power units"
  },
  {
    name: "H120 Fire & Blast Doors",
    category: "Marine & Offshore",
    image: "/assets/images/products/H120/door.jpeg",
    link: "/trading/h120-doors-windows",
    desc: "120-min hydrocarbon fire & blast barrier doors"
  }
];
---
<BaseLayout title="Velcorix - Mechanical Trading & Consultancy" description="Velcorix is a premier mechanical trading and consultancy firm in UAE, providing expert oil & gas services, industrial equipment rentals, shutdown management, and EPC advisory.">
  <!-- Hero Slider Section -->
  <section class="hero-section">
    <div class="swiper hero-slider">
      <div class="swiper-wrapper">
        <!-- Slide 1 (LCP - eager) -->
        <div class="swiper-slide">
          <img
            class="hero-img"
            src="/assets/images/hero/hero-img-1.webp"
            alt="A Partner You Can Rely On"
            width="1920"
            height="900"
            loading="eager"
            decoding="async"
          />
          <div class="hero-overlay"></div>
          <div class="container hero-content">
            <h1 class="hero-title text-white">A Partner You Can Rely On</h1>
            <p class="hero-subtitle">
              Responsive, compliant, and quality-driven mechanical equipment trading.
            </p>
            <a href="/contact" class="btn btn-primary btn-lg">Get in Touch</a>
          </div>
        </div>

        <!-- Slide 2 -->
        <div class="swiper-slide">
          <img
            class="hero-img"
            src="/assets/images/hero/hero-img-2.webp"
            alt="Comprehensive Mechanical Equipment Supply"
            width="1920"
            height="900"
            loading="lazy"
            decoding="async"
          />
          <div class="hero-overlay"></div>
          <div class="container hero-content">
            <h2 class="hero-title text-white">
              Comprehensive Mechanical Equipment Supply
            </h2>
            <p class="hero-subtitle">
              Sourcing top-tier hardware, PPE, and structural steel for industrial projects.
            </p>
            <a href="/trading" class="btn btn-primary btn-lg">Explore our Catalogue</a>
          </div>
        </div>

        <!-- Slide 3 -->
        <div class="swiper-slide">
          <img
            class="hero-img"
            src="/assets/images/hero/hero-img-3.webp"
            alt="Reliable Consumables & ATEX Products for Critical Operations"
            width="1920"
            height="900"
            loading="lazy"
            decoding="async"
          />
          <div class="hero-overlay"></div>
          <div class="container hero-content">
            <h2 class="hero-title text-white">
              Reliable Consumables & ATEX Products for Critical Operations
            </h2>
            <p class="hero-subtitle">
              Certified, high-quality products ready for onshore and offshore projects.
            </p>
            <a href="/trading" class="btn btn-primary btn-lg">View Trading Solutions</a>
          </div>
        </div>
      </div>
      <div class="swiper-pagination"></div>
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
    </div>
  </section>

  <!-- About Teaser Section -->
  <section class="section-padding bg-light">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6">
          <picture>
            <source
              type="image/webp"
              srcset="
                /assets/images/other/image.webp   800w,
                /assets/images/other/image.webp 1200w
              "
              sizes="(max-width: 768px) 100vw, 600px"
            />
            <img
              src="/assets/images/other/image.webp"
              alt="Premier Mechanical Services in UAE"
              class="img-fluid rounded shadow"
              width="600"
              height="400"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
        <div class="col-lg-6">
          <h2 class="text-uppercase text-secondary mb-2 h4">
            Premier Mechanical Equipment Trading in UAE
          </h2>
          <p class="mb-4">
            Velcorix is a leading mechanical equipment trading company
            serving the oil and gas, energy, and industrial sectors. We
            support operators, EPC contractors, and service providers by
            supplying high-quality hardware, welding consumables, PPE, structural steel, and specialized ATEX products for critical site operations globally and across the
            UAE.
          </p>
          <ul class="list-unstyled mb-4">
            <li class="mb-2 d-flex align-items-center">
              <span class="bullet-dot me-2"></span> Quality Assurance
            </li>
            <li class="mb-2 d-flex align-items-center">
              <span class="bullet-dot me-2"></span> Expert Engineering Team
            </li>
            <li class="mb-2 d-flex align-items-center">
              <span class="bullet-dot me-2"></span> Timely Delivery
            </li>
          </ul>
          <a href="/about" class="btn btn-outline-dark">Read More</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trading Categories Section -->
  <section class="section-padding trading-categories-section">
    <div class="container">
      <div class="section-title text-center mb-5">
        <h2>Trading Categories</h2>
        <p>Three specialized supply divisions engineered for industrial operations across the UAE</p>
      </div>

      <div class="row g-4 justify-content-center">
        {tradingCategories.map((category) => (
          <div class="col-lg-4 col-md-6">
            <a href={category.link} class="text-decoration-none text-dark d-block h-100">
              <div class="category-showcase-card h-100">
                <div class="category-card-media position-relative">
                  <img
                    src={category.image}
                    alt={category.title}
                    class="img-fluid category-card-img"
                    onerror="this.onerror=null; this.src='/assets/images/logo/velcorix-logo.png';"
                    loading="lazy"
                  />
                  <span class="category-card-badge">
                    <i class={`${category.icon} me-1`}></i> {category.badge}
                  </span>
                </div>
                <div class="category-card-content">
                  <h3 class="category-card-title">{category.title}</h3>
                  <p class="category-card-desc">{category.desc}</p>
                  
                  <div class="category-tags">
                    {category.highlights.map((item) => (
                      <span class="category-tag-pill">{item}</span>
                    ))}
                  </div>

                  <div class="category-card-footer mt-auto pt-3">
                    <span class="category-card-link">
                      Explore Division <i class="fas fa-arrow-right ms-2"></i>
                    </span>
                  </div>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Trading Catalogue - Most Traded Items Carousel -->
  <section class="section-padding bg-light catalogue-carousel-section">
    <div class="container-fluid px-xl-5 px-lg-4 px-3">
      <div class="section-title text-center mb-4">
        <h2>Our Trading Catalogue</h2>
        <p>Most traded items and fast-moving industrial supplies</p>
      </div>

      <div class="catalogue-carousel-wrapper">
        <div class="catalogue-swiper-outer position-relative">
          <div class="swiper catalogue-swiper">
            <div class="swiper-wrapper">
              {mostTradedItems.map((item) => (
                <div class="swiper-slide">
                  <a href={item.link} class="text-decoration-none d-block h-100">
                    <div class="catalogue-item-card">
                      <div class="item-img-box">
                        <img
                          src={item.image}
                          alt={item.name}
                          class="img-fluid"
                          loading="lazy"
                          onerror="this.onerror=null; this.src='/assets/images/logo/velcorix-logo.png';"
                        />
                      </div>
                      <div class="item-info">
                        <span class="item-category-tag">{item.category}</span>
                        <h4 class="item-title" title={item.name}>{item.name}</h4>
                        <p class="item-desc">{item.desc}</p>
                        <div class="item-action">
                          <span class="item-link">
                            View Details <i class="fas fa-chevron-right ms-1"></i>
                          </span>
                        </div>
                      </div>
                    </div>
                  </a>
                </div>
              ))}
            </div>
          </div>

          <!-- Navigation Buttons centered strictly on the card row -->
          <button class="catalogue-nav-btn catalogue-prev" aria-label="Previous items">
            <i class="fas fa-chevron-left"></i>
          </button>
          <button class="catalogue-nav-btn catalogue-next" aria-label="Next items">
            <i class="fas fa-chevron-right"></i>
          </button>
        </div>

        <!-- Pagination directly beneath cards -->
        <div class="catalogue-pagination text-center mt-3"></div>
      </div>

      <div class="text-center mt-3">
        <a href="/trading" class="btn btn-primary px-4 py-2">
          <i class="fas fa-list me-2"></i> View Full Catalogue
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Velcorix Section -->
  <section
    class="section-padding bg-cover-desaturated"
    style="--bg-img: url('/assets/images/services/DSC_2545.JPG');"
  >
    <div class="container">
      <div class="section-title">
        <h2>Why Choose Velcorix</h2>
        <p>Commitment to Excellence and Reliability</p>
      </div>
      <div class="row">
        <div class="col-lg-8 mx-auto">
          <div class="row">
            <div class="col-md-6 mb-4">
              <div class="d-flex align-items-start">
                <div class="me-3 mt-1">
                  <span class="bullet-dot-lg"></span>
                </div>
                <div>
                  <h5 class="fw-bold">Proven Experience</h5>
                  <p class="text-muted small">
                    Extensive experience supplying industrial equipment across UAE's key sectors.
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-4">
              <div class="d-flex align-items-start">
                <div class="me-3 mt-1">
                  <span class="bullet-dot-lg"></span>
                </div>
                <div>
                  <h5 class="fw-bold">Field-Driven</h5>
                  <p class="text-muted small">
                    Product expertise backed by real-world industrial understanding.
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-4">
              <div class="d-flex align-items-start">
                <div class="me-3 mt-1">
                  <span class="bullet-dot-lg"></span>
                </div>
                <div>
                  <h5 class="fw-bold">Rapid Response</h5>
                  <p class="text-muted small">
                    Fast procurement and reliable delivery to your site.
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-4">
              <div class="d-flex align-items-start">
                <div class="me-3 mt-1">
                  <span class="bullet-dot-lg"></span>
                </div>
                <div>
                  <h5 class="fw-bold">Quality Equipment</h5>
                  <p class="text-muted small">
                    Certified, quality-assured trading products from trusted brands.
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-4">
              <div class="d-flex align-items-start">
                <div class="me-3 mt-1">
                  <span class="bullet-dot-lg"></span>
                </div>
                <div>
                  <h5 class="fw-bold">Safety First</h5>
                  <p class="text-muted small">
                    Commitment to providing compliant and safe-to-use materials.
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-4">
              <div class="d-flex align-items-start">
                <div class="me-3 mt-1">
                  <span class="bullet-dot-lg"></span>
                </div>
                <div>
                  <h5 class="fw-bold">Accountability</h5>
                  <p class="text-muted small">
                    Single-point accountability for procurement and logistics.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Industries We Serve Section -->
  <section class="section-padding">
    <div class="container">
      <div class="section-title">
        <h2>Industries We Serve</h2>
        <p>Supporting critical sectors with specialized expertise</p>
      </div>
      <div class="row text-center">
        <div class="col-md-4 mb-4">
          <div
            class="industry-card"
            style="--bg-img: url('/assets/images/services/DSC_2341.JPG');"
          >
            <div class="industry-content">
              <i class="fas fa-oil-can fa-3x mb-3"></i>
              <h5>Oil & Gas</h5>
              <p class="small mb-0">Upstream / Midstream / Downstream</p>
            </div>
          </div>
        </div>
        <div class="col-md-4 mb-4">
          <div
            class="industry-card"
            style="--bg-img: url('/assets/images/services/DSC_2558.JPG');"
          >
            <div class="industry-content">
              <i class="fas fa-industry fa-3x mb-3"></i>
              <h5>Petrochemicals</h5>
              <p class="small mb-0">Petrochemical & Chemical Plants</p>
            </div>
          </div>
        </div>
        <div class="col-md-4 mb-4">
          <div
            class="industry-card"
            style="--bg-img: url('/assets/images/services/DSC_2510.JPG');"
          >
            <div class="industry-content">
              <i class="fas fa-bolt fa-3x mb-3"></i>
              <h5>Power & Energy</h5>
              <p class="small mb-0">Power Generation & Distribution</p>
            </div>
          </div>
        </div>
        <div class="col-md-6 mb-4">
          <div
            class="industry-card"
            style="--bg-img: url('/assets/images/services/DSC_2470.JPG');"
          >
            <div class="industry-content">
              <i class="fas fa-cogs fa-3x mb-3"></i>
              <h5>Manufacturing</h5>
              <p class="small mb-0">Industrial Manufacturing & Processing</p>
            </div>
          </div>
        </div>
        <div class="col-md-6 mb-4">
          <div
            class="industry-card"
            style="--bg-img: url('/assets/images/services/DSC_2456.JPG');"
          >
            <div class="industry-content">
              <i class="fas fa-hard-hat fa-3x mb-3"></i>
              <h5>EPC & Turnkey</h5>
              <p class="small mb-0">
                Engineering, Procurement & Construction
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Approach Section -->
