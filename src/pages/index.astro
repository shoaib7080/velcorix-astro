---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaSection from '../components/CtaSection.astro';
---
<BaseLayout title="Velcorix - Mechanical Trading & Consultancy" description="Velcorix is a premier mechanical trading and consultancy firm in UAE, providing expert oil & gas services, industrial equipment rentals, shutdown management, and EPC advisory.">
  <!-- Hero Slider Section -->
  <section class="hero-section">
    <div class="swiper hero-slider">
      <div class="swiper-wrapper">
        <div class="swiper-slide">
          <picture class="hero-picture">
            <source
              type="image/avif"
              srcset="
                /assets/images/hero/optimized/DSC_2307-800.avif   800w,
                /assets/images/hero/optimized/DSC_2307-1200.avif 1200w,
                /assets/images/hero/optimized/DSC_2307-1920.avif 1920w
              "
              sizes="(max-width: 768px) 100vw, 1200px"
            />
            <source
              type="image/webp"
              srcset="
                /assets/images/hero/optimized/DSC_2307-800.webp   800w,
                /assets/images/hero/optimized/DSC_2307-1200.webp 1200w,
                /assets/images/hero/optimized/DSC_2307-1920.webp 1920w
              "
              sizes="(max-width: 768px) 100vw, 1200px"
            />
            <img
              class="hero-img"
              src="/assets/images/hero/optimized/DSC_2307-1200.jpg"
              srcset="
                /assets/images/hero/optimized/DSC_2307-800.jpg   800w,
                /assets/images/hero/optimized/DSC_2307-1200.jpg 1200w,
                /assets/images/hero/optimized/DSC_2307-1920.jpg 1920w
              "
              sizes="(max-width: 768px) 100vw, 1200px"
              alt="A Partner You Can Rely On"
              width="1920"
              height="900"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <div class="hero-overlay"></div>
          <div class="container hero-content">
            <h2 class="hero-title text-white">A Partner You Can Rely On</h2>
            <p class="hero-subtitle">
              Responsive, compliant, and quality-driven mechanical equipment trading.
            </p>
            <a href="/contact" class="btn btn-primary btn-lg">Get in Touch</a>
          </div>
        </div>

        <!-- Slide 1 (LCP - eager + preload) -->
        <div class="swiper-slide">
          <picture class="hero-picture">
            <source
              type="image/avif"
              srcset="
                /assets/images/hero/optimized/DSC_2319-800.avif   800w,
                /assets/images/hero/optimized/DSC_2319-1200.avif 1200w,
                /assets/images/hero/optimized/DSC_2319-1920.avif 1920w
              "
              sizes="(max-width: 768px) 100vw, 1200px"
            />
            <source
              type="image/webp"
              srcset="
                /assets/images/hero/optimized/DSC_2319-800.webp   800w,
                /assets/images/hero/optimized/DSC_2319-1200.webp 1200w,
                /assets/images/hero/optimized/DSC_2319-1920.webp 1920w
              "
              sizes="(max-width: 768px) 100vw, 1200px"
            />
            <img
              class="hero-img"
              src="/assets/images/hero/optimized/DSC_2319-1200.jpg"
              srcset="
                /assets/images/hero/optimized/DSC_2319-800.jpg   800w,
                /assets/images/hero/optimized/DSC_2319-1200.jpg 1200w,
                /assets/images/hero/optimized/DSC_2319-1920.jpg 1920w
              "
              sizes="(max-width: 768px) 100vw, 1200px"
              alt="End-to-End Oil & Gas Consultancy Services"
              width="1920"
              height="900"
              loading="eager"
              decoding="async"
            />
          </picture>
          <div class="hero-overlay"></div>
          <div class="container hero-content">
            <h1 class="hero-title">
              Comprehensive Mechanical Equipment Supply
            </h1>
            <p class="hero-subtitle">
              Sourcing top-tier hardware, PPE, and structural steel for industrial projects.
            </p>
            <a href="/trading" class="btn btn-primary btn-lg">Explore our Catalogue</a>
          </div>
        </div>

        <!-- Slide 2 -->
        <div class="swiper-slide">
          <picture class="hero-picture">
            <source
              type="image/avif"
              srcset="
                /assets/images/hero/optimized/DSC_2311-800.avif   800w,
                /assets/images/hero/optimized/DSC_2311-1200.avif 1200w,
                /assets/images/hero/optimized/DSC_2311-1920.avif 1920w
              "
              sizes="(max-width: 768px) 100vw, 1200px"
            />
            <source
              type="image/webp"
              srcset="
                /assets/images/hero/optimized/DSC_2311-800.webp   800w,
                /assets/images/hero/optimized/DSC_2311-1200.webp 1200w,
                /assets/images/hero/optimized/DSC_2311-1920.webp 1920w
              "
              sizes="(max-width: 768px) 100vw, 1200px"
            />
            <img
              class="hero-img"
              src="/assets/images/hero/optimized/DSC_2311-1200.jpg"
              srcset="
                /assets/images/hero/optimized/DSC_2311-800.jpg   800w,
                /assets/images/hero/optimized/DSC_2311-1200.jpg 1200w,
                /assets/images/hero/optimized/DSC_2311-1920.jpg 1920w
              "
              sizes="(max-width: 768px) 100vw, 1200px"
              alt="Reliable Equipment & Tool Rentals"
              width="1920"
              height="900"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <div class="hero-overlay"></div>
          <div class="container hero-content">
            <h2 class="hero-title text-white">
              Reliable Consumables & ATEX Products for Critical Operations
            </h2>
            <p class="hero-subtitle">
              Certified, high-quality products ready for onshore and offshore projects.
            </p>
            <a href="/trading" class="btn btn-primary btn-lg">View Trading Solutions</a>
          </div>
        </div>
      </div>
      <div class="swiper-pagination"></div>
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
    </div>
  </section>

  <!-- About Teaser Section -->
  <section class="section-padding bg-light">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6">
          <picture>
            <source
              type="image/webp"
              srcset="
                /assets/images/hero/optimized/DSC_2345-800.webp   800w,
                /assets/images/hero/optimized/DSC_2345-1200.webp 1200w
              "
              sizes="(max-width: 768px) 100vw, 600px"
            />
            <img
              src="/assets/images/hero/optimized/DSC_2345-800.jpg"
              alt="Premier Mechanical Services in UAE"
              class="img-fluid rounded shadow"
              width="600"
              height="400"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
        <div class="col-lg-6">
          <h4 class="text-uppercase text-secondary mb-2">
            Premier Mechanical Equipment Trading in UAE
          </h4>
          <p class="mb-4">
            Velcorix is a leading mechanical equipment trading company
            serving the oil and gas, energy, and industrial sectors. We
            support operators, EPC contractors, and service providers by
            supplying high-quality hardware, welding consumables, PPE, structural steel, and specialized ATEX products for critical site operations globally and across the
            UAE.
          </p>
          <ul class="list-unstyled mb-4">
            <li class="mb-2">
              <i class="fas fa-check-circle text-primary me-2"></i> Quality Assurance
            </li>
            <li class="mb-2">
              <i class="fas fa-check-circle text-primary me-2"></i> Expert Engineering Team
            </li>
            <li class="mb-2">
              <i class="fas fa-check-circle text-primary me-2"></i> Timely Delivery
            </li>
          </ul>
          <a href="/about" class="btn btn-outline-dark">Read More</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Trading Categories -->
  <section class="section-padding">
    <div class="container">
      <div class="section-title">
        <h2>Our Trading Catalogue</h2>
        <p>Comprehensive mechanical equipment and supplies</p>
      </div>
      <div class="row g-4 justify-content-center">
        <!-- Hardware -->
        <div class="col-lg-3 col-md-4 col-sm-6">
          <a href="/trading/hardware" class="text-decoration-none text-dark d-block h-100">
            <div class="service-card h-100 text-center border-0 shadow-sm" style="border: 1px solid rgba(0,0,0,0.05) !important;">
              <div class="service-icon mb-3">
                <i class="fas fa-tools"></i>
              </div>
              <h5 class="fw-bold mb-2 text-primary">Hardware</h5>
              <p class="text-muted small mb-0">Tools, abrasives, and general hardware supplies.</p>
            </div>
          </a>
        </div>
        <!-- Stationery -->
        <div class="col-lg-3 col-md-4 col-sm-6">
          <a href="/trading/stationery" class="text-decoration-none text-dark d-block h-100">
            <div class="service-card h-100 text-center border-0 shadow-sm" style="border: 1px solid rgba(0,0,0,0.05) !important;">
              <div class="service-icon mb-3">
                <i class="fas fa-paperclip"></i>
              </div>
              <h5 class="fw-bold mb-2 text-primary">Stationery</h5>
              <p class="text-muted small mb-0">Office and industrial stationery essentials.</p>
            </div>
          </a>
        </div>
        <!-- Welding Consumables -->
        <div class="col-lg-3 col-md-4 col-sm-6">
          <a href="/trading/welding-consumables" class="text-decoration-none text-dark d-block h-100">
            <div class="service-card h-100 text-center border-0 shadow-sm" style="border: 1px solid rgba(0,0,0,0.05) !important;">
              <div class="service-icon mb-3">
                <i class="fas fa-fire-burner"></i>
              </div>
              <h5 class="fw-bold mb-2 text-primary">Welding Consumables</h5>
              <p class="text-muted small mb-0">Rods, torches, and specialized welding supplies.</p>
            </div>
          </a>
        </div>
        <!-- PPE -->
        <div class="col-lg-3 col-md-4 col-sm-6">
          <a href="/trading/ppe" class="text-decoration-none text-dark d-block h-100">
            <div class="service-card h-100 text-center border-0 shadow-sm" style="border: 1px solid rgba(0,0,0,0.05) !important;">
              <div class="service-icon mb-3">
                <i class="fas fa-hard-hat"></i>
              </div>
              <h5 class="fw-bold mb-2 text-primary">PPE</h5>
              <p class="text-muted small mb-0">Safety gear and personal protective equipment.</p>
            </div>
          </a>
        </div>
        <!-- Structural Steel -->
        <div class="col-lg-3 col-md-4 col-sm-6">
          <a href="/trading/structural-steel" class="text-decoration-none text-dark d-block h-100">
            <div class="service-card h-100 text-center border-0 shadow-sm" style="border: 1px solid rgba(0,0,0,0.05) !important;">
              <div class="service-icon mb-3">
                <i class="fas fa-cubes"></i>
              </div>
              <h5 class="fw-bold mb-2 text-primary">Structural Steel</h5>
              <p class="text-muted small mb-0">Beams, plates, and galvanized sheets.</p>
            </div>
          </a>
        </div>
        <!-- ATEX Products -->
        <div class="col-lg-3 col-md-4 col-sm-6">
          <a href="/trading/atex" class="text-decoration-none text-dark d-block h-100">
            <div class="service-card h-100 text-center border-0 shadow-sm" style="border: 1px solid rgba(0,0,0,0.05) !important;">
              <div class="service-icon mb-3">
                <i class="fas fa-bolt"></i>
              </div>
              <h5 class="fw-bold mb-2 text-primary">ATEX Products</h5>
              <p class="text-muted small mb-0">Explosion-proof and hazardous area equipment.</p>
            </div>
          </a>
        </div>
        <!-- H120 Doors & Windows -->
        <div class="col-lg-3 col-md-4 col-sm-6">
          <a href="/trading/h120-doors-windows" class="text-decoration-none text-dark d-block h-100">
            <div class="service-card h-100 text-center border-0 shadow-sm" style="border: 1px solid rgba(0,0,0,0.05) !important;">
              <div class="service-icon mb-3">
                <i class="fas fa-door-closed"></i>
              </div>
              <h5 class="fw-bold mb-2 text-primary">H120 Doors & Windows</h5>
              <p class="text-muted small mb-0">Fire-rated and blast-resistant solutions.</p>
            </div>
          </a>
        </div>
      </div>
      <div class="text-center mt-5">
        <a href="/trading" class="btn btn-primary btn-lg px-5">
          <i class="fas fa-list me-2"></i> View Full Catalogue
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Velcorix Section -->
  <section
    class="section-padding bg-cover-desaturated"
    style="--bg-img: url('/assets/images/services/DSC_2545.JPG');"
  >
    <div class="container">
      <div class="section-title">
        <h2>Why Choose Velcorix</h2>
        <p>Commitment to Excellence and Reliability</p>
      </div>
      <div class="row">
        <div class="col-lg-8 mx-auto">
          <div class="row">
            <div class="col-md-6 mb-4">
              <div class="d-flex align-items-start">
                <div class="me-3 text-primary">
                  <i class="fas fa-check-circle fa-2x"></i>
                </div>
                <div>
                  <h5 class="fw-bold">Proven Experience</h5>
                  <p class="text-muted small">
                    Extensive experience supplying industrial equipment across UAE's key sectors.
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-4">
              <div class="d-flex align-items-start">
                <div class="me-3 text-primary">
                  <i class="fas fa-check-circle fa-2x"></i>
                </div>
                <div>
                  <h5 class="fw-bold">Field-Driven</h5>
                  <p class="text-muted small">
                    Product expertise backed by real-world industrial understanding.
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-4">
              <div class="d-flex align-items-start">
                <div class="me-3 text-primary">
                  <i class="fas fa-check-circle fa-2x"></i>
                </div>
                <div>
                  <h5 class="fw-bold">Rapid Response</h5>
                  <p class="text-muted small">
                    Fast procurement and reliable delivery to your site.
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-4">
              <div class="d-flex align-items-start">
                <div class="me-3 text-primary">
                  <i class="fas fa-check-circle fa-2x"></i>
                </div>
                <div>
                  <h5 class="fw-bold">Quality Equipment</h5>
                  <p class="text-muted small">
                    Certified, quality-assured trading products from trusted brands.
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-4">
              <div class="d-flex align-items-start">
                <div class="me-3 text-primary">
                  <i class="fas fa-check-circle fa-2x"></i>
                </div>
                <div>
                  <h5 class="fw-bold">Safety First</h5>
                  <p class="text-muted small">
                    Commitment to providing compliant and safe-to-use materials.
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-4">
              <div class="d-flex align-items-start">
                <div class="me-3 text-primary">
                  <i class="fas fa-check-circle fa-2x"></i>
                </div>
                <div>
                  <h5 class="fw-bold">Accountability</h5>
                  <p class="text-muted small">
                    Single-point accountability for procurement and logistics.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Industries We Serve Section -->
  <section class="section-padding">
    <div class="container">
      <div class="section-title">
        <h2>Industries We Serve</h2>
        <p>Supporting critical sectors with specialized expertise</p>
      </div>
      <div class="row text-center">
        <div class="col-md-4 mb-4">
          <div
            class="industry-card"
            style="--bg-img: url('/assets/images/services/DSC_2341.JPG');"
          >
            <div class="industry-content">
              <i class="fas fa-oil-can fa-3x mb-3"></i>
              <h5>Oil & Gas</h5>
              <p class="small mb-0">Upstream / Midstream / Downstream</p>
            </div>
          </div>
        </div>
        <div class="col-md-4 mb-4">
          <div
            class="industry-card"
            style="--bg-img: url('/assets/images/services/DSC_2558.JPG');"
          >
            <div class="industry-content">
              <i class="fas fa-industry fa-3x mb-3"></i>
              <h5>Petrochemicals</h5>
              <p class="small mb-0">Petrochemical & Chemical Plants</p>
            </div>
          </div>
        </div>
        <div class="col-md-4 mb-4">
          <div
            class="industry-card"
            style="--bg-img: url('/assets/images/services/DSC_2510.JPG');"
          >
            <div class="industry-content">
              <i class="fas fa-bolt fa-3x mb-3"></i>
              <h5>Power & Energy</h5>
              <p class="small mb-0">Power Generation & Distribution</p>
            </div>
          </div>
        </div>
        <div class="col-md-6 mb-4">
          <div
            class="industry-card"
            style="--bg-img: url('/assets/images/services/DSC_2470.JPG');"
          >
            <div class="industry-content">
              <i class="fas fa-cogs fa-3x mb-3"></i>
              <h5>Manufacturing</h5>
              <p class="small mb-0">Industrial Manufacturing & Processing</p>
            </div>
          </div>
        </div>
        <div class="col-md-6 mb-4">
          <div
            class="industry-card"
            style="--bg-img: url('/assets/images/services/DSC_2456.JPG');"
          >
            <div class="industry-content">
              <i class="fas fa-hard-hat fa-3x mb-3"></i>
              <h5>EPC & Turnkey</h5>
              <p class="small mb-0">
                Engineering, Procurement & Construction
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Approach Section -->
