---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
---
<BaseLayout title="Contact Us - Velcorix" description="Get in touch with Velcorix for your mechanical equipment trading needs. Contact our team in Dubai for a quote.">
    <PageHeader 
      title="Contact Us" 
      subtitle="We'd Love to Hear From You" 
      bgImage="/assets/images/hero/DSC_2414.JPG" 
    />

    <section class="section-padding">
      <div class="container">
        <div class="row">
          <div class="col-lg-6 mb-4">
            <div class="p-4 bg-light shadow rounded h-100">
              <h3 class="mb-4 text-primary">Get In Touch</h3>
              <form action="https://api.web3forms.com/submit" method="POST" id="form">
                <input
                  type="hidden"
                  name="access_key"
                  value="a3101cef-d9c3-4070-860a-ac480d9851c7"
                />
                <input
                  type="hidden"
                  name="subject"
                  value="New enquiry from Velcorix"
                />
                <input
                  type="checkbox"
                  name="botcheck"
                  id=""
                  style="display: none"
                />
                <div class="mb-3">
                  <label for="name" class="form-label">Name</label>
                  <input
                    type="text"
                    class="form-control"
                    id="name"
                    placeholder="Your Name"
                    name="Name"
                    required
                  />
                </div>
                <div class="mb-3">
                  <label for="email" class="form-label">Email</label>
                  <input
                    type="email"
                    class="form-control"
                    id="email"
                    placeholder="Your Email"
                    name="Email"
                    required
                  />
                </div>
                <div class="mb-3">
                  <label for="subject" class="form-label">Subject</label>
                  <input
                    type="text"
                    class="form-control"
                    id="subject"
                    placeholder="Subject"
                    name="Subject"
                    required
                  />
                </div>
                <div class="mb-3">
                  <label for="message" class="form-label">Message</label>
                  <textarea
                    class="form-control"
                    id="message"
                    rows="5"
                    placeholder="Your Message"
                    name="Message"
                    required
                  ></textarea>
                </div>
                <button type="submit" id="submitBtn" class="btn btn-primary w-100 py-2 fw-semibold">
                  Send Message
                </button>
                <div id="result" class="mt-3" style="display: none;"></div>
              </form>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="h-100">
              <div class="mb-4">
                <h3 class="text-secondary">Contact Information</h3>
                <p>
                  Feel free to visit our office or contact us via phone or
                  email.
                </p>
              </div>
              <div class="d-flex align-items-center mb-4">
                <div class="bg-primary text-white p-3 rounded-circle me-3">
                  <i class="fas fa-map-marker-alt fa-lg"></i>
                </div>
                <div>
                  <h5 class="mb-0">Address</h5>
                  <p class="mb-0 text-muted">
                    Business Bay, Dubai, United Arab Emirates
                  </p>
                </div>
              </div>
              <div class="d-flex align-items-center mb-4">
                <div class="bg-primary text-white p-3 rounded-circle me-3">
                  <i class="fas fa-phone fa-lg"></i>
                </div>
                <div>
                  <h5 class="mb-0">Phone</h5>
                  <p class="mb-0 text-muted">+971 50 123 4567</p>
                </div>
              </div>
              <div class="d-flex align-items-center mb-4">
                <div class="bg-primary text-white p-3 rounded-circle me-3">
                  <i class="fas fa-envelope fa-lg"></i>
                </div>
                <div>
                  <h5 class="mb-0">Email</h5>
                  <p class="mb-0 text-muted">
                    <a href="mailto:info@velcorix.com" class="text-muted text-decoration-none">info@velcorix.com</a><br />
                    <a href="mailto:sales@velcorix.com" class="text-muted text-decoration-none">sales@velcorix.com</a>
                  </p>
                </div>
              </div>

              <!-- Map Placeholder -->
              <div
                class="bg-secondary text-white d-flex align-items-center justify-content-center rounded"
                style="height: 250px"
              >
                <p class="mb-0"><i class="fas fa-map"></i> Google Maps Embed</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Form Submission Script -->
    <script is:inline>
      const form = document.getElementById("form");
      const result = document.getElementById("result");
      const submitBtn = document.getElementById("submitBtn");

      // Web3Forms keys:
      // 1. info@velcorix.com
      // 2. sales@velcorix.com
      const ACCESS_KEYS = [
        "a3101cef-d9c3-4070-860a-ac480d9851c7",
        "7bfa00e9-ce33-4062-90be-fbc8a6d91d01",
      ];

      if (form) {
        form.addEventListener("submit", async function (e) {
          e.preventDefault();

          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML =
              '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Sending...';
          }

          if (result) {
            result.className = "alert alert-info mt-3 py-2 text-center small";
            result.style.display = "block";
            result.textContent = "Sending your message...";
          }

          const formData = new FormData(form);
          const formValues = Object.fromEntries(formData);

          try {
            // Dispatch to both recipients in parallel
            const requests = ACCESS_KEYS.map((key) =>
              fetch("https://api.web3forms.com/submit", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  Accept: "application/json",
                },
                body: JSON.stringify({
                  ...formValues,
                  access_key: key,
                }),
              }).then(async (response) => {
                const data = await response.json().catch(() => ({}));
                return {
                  ok: response.status === 200 && data.success,
                  data,
                };
              })
            );

            const settledResults = await Promise.allSettled(requests);

            const hasSuccess = settledResults.some(
              (r) => r.status === "fulfilled" && r.value?.ok
            );

            if (hasSuccess) {
              if (result) {
                result.className = "alert alert-success mt-3 py-2 text-center small";
                result.textContent =
                  "Thank you! Your message has been sent successfully.";
              }
              form.reset();
            } else {
              const firstError = settledResults.find(
                (r) => r.status === "fulfilled" && r.value?.data?.message
              );
              if (result) {
                result.className = "alert alert-danger mt-3 py-2 text-center small";
                result.textContent =
                  firstError?.value?.data?.message ||
                  "Something went wrong. Please try again or email us directly at info@velcorix.com / sales@velcorix.com.";
              }
            }
          } catch (error) {
            if (result) {
              result.className = "alert alert-danger mt-3 py-2 text-center small";
              result.textContent =
                "Network error. Please try again or email us directly at info@velcorix.com / sales@velcorix.com.";
            }
          } finally {
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = "Send Message";
            }
          }
        });
      }
    </script>
</BaseLayout>
