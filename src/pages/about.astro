---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaSection from '../components/CtaSection.astro';
---
<BaseLayout title="About Us - Velcorix Mechanical Equipment Trading" description="Learn more about Velcorix, a leading UAE-based provider of mechanical trading products, industrial hardware, PPE, and structural steel for the oil, gas, and energy sectors.">
  <!-- Page Header -->
  <PageHeader 
    title="About Velcorix" 
    subtitle="Your trusted partner for mechanical equipment and industrial supplies across the UAE." 
    bgImage="/assets/images/hero/DSC_2378.JPG" 
  />

  <!-- Main Content -->
  <section class="section-padding">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6 mb-4">
          <h2 class="mb-3">Leading Mechanical Equipment Traders in UAE</h2>
          <p>
            Velcorix is a UAE-based mechanical equipment trading
            company supporting oil & gas, energy, and industrial projects. We
            work closely with operators, EPC contractors, and service
            providers to supply high-quality hardware, PPE, structural steel, and specialized ATEX products across Dubai, Abu Dhabi, and
            the Northern Emirates.
          </p>
          <p>
            Our team brings hands-on industry experience,
            ensuring that the products we supply meet your exact requirements, are fully compliant, and
            delivered on time.
          </p>
        </div>
        <div class="col-lg-6">
          <img
            src="/assets/images/other/DSC_2439.JPG"
            class="img-fluid shadow"
            style="
              border-radius: 8px;
              object-fit: cover;
              width: 100%;
              height: 400px;
            "
            alt="Velcorix Professional Engineering and Consultancy Team in UAE"
            onerror="this.onerror=null; this.src='/assets/images/logo/velcorix-logo.png';"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- What We Provide Section -->
  <section class="section-padding">
    <div class="container">
      <div class="section-title text-center">
        <h2>What We Provide</h2>
      </div>
      <div class="row text-center">
        <div class="col-md-4 mb-4">
          <div
            class="industry-card"
            style="--bg-img: url('/assets/images/services/DSC_2558.JPG');"
          >
            <div class="industry-content">
              <i class="fas fa-boxes fa-3x mb-3"></i>
              <h5>Comprehensive Catalogue</h5>
              <p class="small mb-0">Hardware, PPE, Welding, and Steel</p>
            </div>
          </div>
        </div>
        <div class="col-md-4 mb-4">
          <div
            class="industry-card"
            style="--bg-img: url('/assets/images/services/DSC_2510.JPG');"
          >
            <div class="industry-content">
              <i class="fas fa-certificate fa-3x mb-3"></i>
              <h5>Certified Quality</h5>
              <p class="small mb-0">
                Industry-compliant and trusted brands
              </p>
            </div>
          </div>
        </div>
        <div class="col-md-4 mb-4">
          <div
            class="industry-card"
            style="--bg-img: url('/assets/images/services/DSC_2341.JPG');"
          >
            <div class="industry-content">
              <i class="fas fa-truck-loading fa-3x mb-3"></i>
              <h5>Reliable Logistics</h5>
              <p class="small mb-0">Timely delivery across the UAE</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What We Stand For -->
  <section class="section-padding bg-light">
    <div class="container">
      <div class="section-title text-center">
        <h2>Our Operating Principles</h2>
      </div>
      <div class="row">
        <div class="col-lg-8 mx-auto text-center">
          <div class="row">
            <div class="col-md-6 mb-4">
              <div class="d-flex align-items-start text-start">
                <div class="me-3 text-primary">
                  <i class="fas fa-shield-alt fa-2x"></i>
                </div>
                <div>
                  <h5 class="fw-bold">Safety-First Execution</h5>
                  <p class="text-muted mb-0">
                    Safety-first execution across all operations
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-4">
              <div class="d-flex align-items-start text-start">
                <div class="me-3 text-primary">
                  <i class="fas fa-tools fa-2x"></i>
                </div>
                <div>
                  <h5 class="fw-bold">Industry Expertise</h5>
                  <p class="text-muted mb-0">
                    Sourcing exactly what your project needs
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-4">
              <div class="d-flex align-items-start text-start">
                <div class="me-3 text-primary">
                  <i class="fas fa-handshake fa-2x"></i>
                </div>
                <div>
                  <h5 class="fw-bold">Reliable Partnership</h5>
                  <p class="text-muted mb-0">
                    Long-term commitment to client success
                  </p>
                </div>
              </div>
            </div>
            <div class="col-md-6 mb-4">
              <div class="d-flex align-items-start text-start">
                <div class="me-3 text-primary">
                  <i class="fas fa-file-contract fa-2x"></i>
                </div>
                <div>
                  <h5 class="fw-bold">Compliance & Documentation</h5>
                  <p class="text-muted mb-0">
                    Compliance, documentation, and traceability
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Who We Support Section -->
  <section class="section-padding">
    <div class="container">
      <div class="section-title text-center">
        <h2>Who We Support</h2>
      </div>
      <div class="row text-center">
        <div class="col-md-3 mb-4">
          <div class="p-4 bg-white rounded shadow-sm h-100 border">
            <i class="fas fa-oil-can fa-3x text-primary mb-3"></i>
            <h5 class="fw-bold">Oil & Gas Operators</h5>
          </div>
        </div>
        <div class="col-md-3 mb-4">
          <div class="p-4 bg-white rounded shadow-sm h-100 border">
            <i class="fas fa-industry fa-3x text-primary mb-3"></i>
            <h5 class="fw-bold">EPC & Turnkey Contractors</h5>
          </div>
        </div>
        <div class="col-md-3 mb-4">
          <div class="p-4 bg-white rounded shadow-sm h-100 border">
            <i class="fas fa-wrench fa-3x text-primary mb-3"></i>
            <h5 class="fw-bold">Maintenance & Shutdown Teams</h5>
          </div>
        </div>
        <div class="col-md-3 mb-4">
          <div class="p-4 bg-white rounded shadow-sm h-100 border">
            <i class="fas fa-building fa-3x text-primary mb-3"></i>
            <h5 class="fw-bold">Industrial Facilities and Plants</h5>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Regional Presence & Execution Capability -->
  <section class="section-padding bg-light mb-4">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6 mb-4 mb-lg-0">
          <img
            src="/assets/images/other/DSC_2468.JPG"
            class="img-fluid shadow rounded w-100"
            style="object-fit: cover; height: 350px;"
            alt="Regional Presence"
            onerror="this.onerror=null; this.src='/assets/images/logo/velcorix-logo.png';"
          />
        </div>
        <div class="col-lg-6">
          <h2 class="mb-3">Regional Presence & Execution Capability</h2>
          <p>
            Strategically headquartered in Dubai, Velcorix leverages the UAE's
            robust infrastructure and connectivity to serve clients across the
            Middle East. Our regional presence enables us to mobilize teams
            and equipment swiftly, ensuring timely execution of projects in
            dynamic environments.
          </p>
          <p>
            Our local expertise, combined with a deep understanding of
            regional regulations and industry standards, positions us as a
            reliable partner for complex industrial operations.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <CtaSection 
    heading="Ready to Source the Best Industrial Equipment?" 
    subtext="Contact our team today to request a quote or discuss your supply requirements."
    buttonText="Request a Quote" 
    buttonLink="/contact" 
  />
</BaseLayout>
