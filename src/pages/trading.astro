---
<BaseLayout title="Trading Categories - Velcorix" description="Explore Velcorix's comprehensive range of industrial equipment trading, structural steel, and mechanical supply products.">
  <PageHeader 
    title="Trading Categories" 
    subtitle="Our Comprehensive Range of Quality Products & Industrial Equipment" 
    bgImage="/assets/images/hero/DSC_2364-1920.jpg" 
  />

  <section class="py-5 bg-light">
    <div class="container text-center">
      <p class="lead mb-0">
        Velcorix provides high-quality industrial equipment supply, structural steel, and trading materials for construction, manufacturing, and oil & gas operations across the UAE.
      </p>
    </div>
  </section>

  <!-- Mechanical Consumables & Supplies Section -->
  <section id="mechanical-consumables" class="section-padding pb-4">
    <div class="container">
      <div class="section-title text-center mb-5">
        <h2 class="fw-bold display-6" style="color: #1a284c;">MECHANICAL CONSUMABLES & SUPPLIES</h2>
        <p class="text-muted">Hardware, PPE, stationery, and welding consumables</p>
      </div>

      <div class="row g-4 justify-content-center">
        {generalCategories.map((cat) => (
          <div class="col-lg-4 col-md-6">
            <a href={cat.link} class="text-decoration-none text-dark d-block h-100">
              <div class="trading-category-card h-100 shadow-sm bg-white rounded overflow-hidden">
                <div class="card-img-container position-relative d-flex align-items-center justify-content-center bg-white" style="height: 220px; padding: 1.25rem;">
                  <img src={cat.image} alt={cat.title} class="img-fluid" style="max-height: 100%; max-width: 100%; object-fit: contain; filter: brightness(1.02) contrast(1.02);" onerror="this.onerror=null; this.src='/assets/images/logo/velcorix-logo.png';" />
                  <div class="icon-badge text-white position-absolute d-flex align-items-center justify-content-center rounded-circle shadow" style="background-color: #c7a14a;">
                    <i class={cat.icon}></i>
                  </div>
                </div>
                <div class="card-body p-4 pt-5 text-center">
                  <h5 class="fw-bold mb-2" style="color: #1a284c;">{cat.title}</h5>
                  <div class="badge bg-light text-dark border mb-3">{cat.products.length} Products</div>
                  
                  <ul class="list-unstyled text-start mb-0">
                    {cat.products.slice(0, 5).map((product) => (
                      <li class="mb-2 text-muted small border-bottom pb-1 text-truncate d-flex align-items-center"><span class="bullet-dot me-2 opacity-50"></span> {product}</li>
                    ))}
                    {cat.products.length > 5 && (
                      <li class="mb-2 text-primary small fw-bold text-center pt-2">+ {cat.products.length - 5} more...</li>
                    )}
                  </ul>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Industrial Equipment Trading Section -->
  <section id="industrial-equipment" class="section-padding bg-light pb-4">
    <div class="container">
      <div class="section-title text-center mb-5">
        <h2 class="fw-bold display-6" style="color: #1a284c;">INDUSTRIAL EQUIPMENT TRADING</h2>
        <p class="text-muted">ATEX products, generators, lifting & handling, fluid handling, site support, container materials & H120 fire doors</p>
      </div>

      <div class="row g-4 justify-content-center">
        {equipmentCategories.map((cat) => (
          <div class="col-lg-4 col-md-6">
            <a href={cat.link} class="text-decoration-none text-dark d-block h-100">
              <div class="trading-category-card h-100 shadow-sm bg-white rounded overflow-hidden">
                <div class="card-img-container position-relative d-flex align-items-center justify-content-center bg-white" style="height: 220px; padding: 1.25rem;">
                  <img src={cat.image} alt={cat.title} class="img-fluid" style="max-height: 100%; max-width: 100%; object-fit: contain; filter: brightness(1.02) contrast(1.02);" onerror="this.onerror=null; this.src='/assets/images/logo/velcorix-logo.png';" />
                  <div class="icon-badge text-white position-absolute d-flex align-items-center justify-content-center rounded-circle shadow" style="background-color: #c7a14a;">
                    <i class={cat.icon}></i>
                  </div>
                </div>
                <div class="card-body p-4 pt-5 text-center">
                  <h5 class="fw-bold mb-2" style="color: #1a284c;">{cat.title}</h5>
                  <div class="badge bg-light text-dark border mb-3">{cat.products.length} Products</div>
                  
                  <ul class="list-unstyled text-start mb-0">
                    {cat.products.slice(0, 5).map((product) => (
                      <li class="mb-2 text-muted small border-bottom pb-1 text-truncate d-flex align-items-center"><span class="bullet-dot me-2 opacity-50"></span> {product}</li>
                    ))}
                    {cat.products.length > 5 && (
                      <li class="mb-2 text-primary small fw-bold text-center pt-2">+ {cat.products.length - 5} more...</li>
                    )}
                  </ul>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Steel & Metal Products Section (LAST) -->
  <section id="steel-metal-products" class="section-padding bg-light">
    <div class="container">
      <div class="section-title text-center mb-5">
        <h2 class="fw-bold display-6" style="color: #1a284c;">STEEL & METAL PRODUCTS</h2>
        <p class="text-muted">High-grade structural steel sections, plates, beams, channels, and gratings</p>
      </div>

      <div class="row g-4 justify-content-center">
        {steelCategories.map((cat) => (
          <div class="col-lg-4 col-md-6">
            <a href={cat.link} class="text-decoration-none text-dark d-block h-100">
              <div class="trading-category-card h-100 shadow-sm bg-white rounded overflow-hidden">
                <div class="card-img-container position-relative d-flex align-items-center justify-content-center bg-white" style="height: 220px; padding: 1.25rem;">
                  <img src={cat.image} alt={cat.title} class="img-fluid" style="max-height: 100%; max-width: 100%; object-fit: contain; filter: brightness(1.02) contrast(1.02);" onerror="this.onerror=null; this.src='/assets/images/logo/velcorix-logo.png';" />
                  <div class="icon-badge text-white position-absolute d-flex align-items-center justify-content-center rounded-circle shadow" style="background-color: #c7a14a;">
                    <i class={cat.icon}></i>
                  </div>
                </div>
                <div class="card-body p-4 pt-5 text-center">
                  <h5 class="fw-bold mb-2" style="color: #1a284c;">{cat.title}</h5>
                  <div class="badge bg-light text-dark border mb-3">{cat.products.length} Products</div>
                  
                  <ul class="list-unstyled text-start mb-0">
                    {cat.products.slice(0, 5).map((product) => (
                      <li class="mb-2 text-muted small border-bottom pb-1 text-truncate d-flex align-items-center"><span class="bullet-dot me-2 opacity-50"></span> {product}</li>
                    ))}
                    {cat.products.length > 5 && (
                      <li class="mb-2 text-primary small fw-bold text-center pt-2">+ {cat.products.length - 5} more...</li>
                    )}
                  </ul>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaSection 
    heading="Looking for specific industrial equipment or supplies?" 
    subtext="Our procurement team can source certified equipment for your project." 
    buttonText="Contact Us" 
    buttonLink="/contact" 
  />
  <script is:inline>
    // Smooth scroll handler for anchor links on page load or hash change
    function scrollToHash() {
      const hash = window.location.hash;
      if (hash) {
        const target = document.querySelector(hash);
        if (target) {
          setTimeout(() => {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 120);
        }
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', scrollToHash);
    } else {
      scrollToHash();
    }
    window.addEventListener('hashchange', scrollToHash);
  </script>
</BaseLayout>

<style>
  #mechanical-consumables,
  #industrial-equipment,
  #steel-metal-products {
    scroll-margin-top: 85px;
  }
  .trading-category-card {
    transition: all 0.3s ease;
    border: 1px solid #eee;
  }
  .trading-category-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 1rem 3rem rgba(0,0,0,.15)!important;
  }
  .card-img-container {
    border-bottom: 3px solid #ea8223;
    padding: 1rem;
    background-color: white;
  }
  .icon-badge {
    width: 60px;
    height: 60px;
    font-size: 1.5rem;
    bottom: -30px;
    left: 50%;
    transform: translateX(-50%);
    border: 4px solid white;
  }
</style>
