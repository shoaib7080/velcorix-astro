---
<BaseLayout title="Trading Categories - Velcorix" description="Explore Velcorix's comprehensive range of mechanical trading products.">
  <PageHeader 
    title="Trading Categories" 
    subtitle="Our Comprehensive Range of Quality Products" 
    bgImage="/assets/images/hero/DSC_2364-1920.jpg" 
  />

  <section class="py-5 bg-light">
    <div class="container text-center">
      <p class="lead mb-0">
        Velcorix provides high-quality trading materials for construction, manufacturing, and industrial operations across the UAE. Browse our extensive inventory of unique products below.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container">
      <div class="row g-4">
        {categories.map((cat) => (
          <div class="col-lg-4 col-md-6">
            <a href={cat.link} class="text-decoration-none text-dark d-block h-100">
              <div class="trading-category-card h-100 shadow-sm bg-white rounded overflow-hidden">
                <div class="card-img-container position-relative d-flex align-items-center justify-content-center bg-white" style="height: 220px; padding: 1.25rem;">
                  <img src={cat.image} alt={cat.title} class="img-fluid" style="max-height: 100%; max-width: 100%; object-fit: contain; filter: brightness(1.02) contrast(1.02); image-rendering: -webkit-optimize-contrast;" onerror="this.onerror=null; this.src='/assets/images/logo/velcorix-logo.png';" />
                  <div class="icon-badge text-white position-absolute d-flex align-items-center justify-content-center rounded-circle shadow" style="background-color: #c7a14a;">
                    <i class={cat.icon}></i>
                  </div>
                </div>
                <div class="card-body p-4 pt-5 text-center">
                  <div class="d-flex align-items-center justify-content-center gap-2 mb-3">
                    <h4 class="fw-bold mb-0" style="color: #1a284c;">{cat.title}</h4>
                  </div>
                  <div class="badge bg-light text-dark border mb-3">{cat.products.length} Products</div>
                  
                  <ul class="list-unstyled text-start mb-0">
                    {cat.products.length > 0 ? (
                      <Fragment>
                        {cat.products.slice(0, 5).map((product) => (
                          <li class="mb-2 text-muted small border-bottom pb-1 text-truncate"><i class="fas fa-check text-primary me-2 opacity-50"></i> {product}</li>
                        ))}
                        {cat.products.length > 5 && (
                          <li class="mb-2 text-primary small fw-bold text-center pt-2">+ {cat.products.length - 5} more...</li>
                        )}
                      </Fragment>
                    ) : (
                      <li class="mb-2 text-muted small fst-italic text-center">Coming soon</li>
                    )}
                  </ul>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaSection 
    heading="Looking for a specific product?" 
    subtext="Our team can source it for you." 
    buttonText="Contact Us" 
    buttonLink="/contact" 
  />
</BaseLayout>

<style>
  .trading-category-card {
    transition: all 0.3s ease;
    border: 1px solid #eee;
  }
  .trading-category-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 1rem 3rem rgba(0,0,0,.15)!important;
    border-color: #ea8223;
  }
  .card-img-container {
    border-bottom: 3px solid #ea8223;
    padding: 1rem;
    background-color: white;
  }
  .icon-badge {
    width: 60px;
    height: 60px;
    font-size: 1.5rem;
    bottom: -30px;
    left: 50%;
    transform: translateX(-50%);
    border: 4px solid white;
  }
</style>
