        <div class="section-title">
          <h2>Where Our Advisory Services Are Applied</h2>
        </div>
        <div class="row g-4">
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-chart-line"></i>
              </div>
              <h4>New Project Feasibility</h4>
              <p class="small text-muted mb-0">
                Assessing technical, financial, and operational viability before capital commitment.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-search-dollar"></i>
              </div>
              <h4>Expansion & Capacity Planning</h4>
              <p class="small text-muted mb-0">
                Evaluating future demand, infrastructure requirements, and scalability potential.
              </p>
            </div>
          </div>
          <div class="col-md-3">
            <div class="service-card text-center h-100">
              <div class="service-icon">
                <i class="fas fa-project-diagram"></i>
              </div>
