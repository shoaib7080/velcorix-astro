              </div>
              <h4>High-Risk or Delayed Projects</h4>
              <p class="small text-muted mb-0">
               Supporting recovery, restructuring, or controlled exit strategies.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Capability Details (How We Do It) -->
    <section class="section-padding bg-light">
      <div class="container">
