    { title: "Fastening Solutions", desc: "High-tensile bolts, nuts, washers, and chemical anchors.", icon: "fas fa-circle" },
    { title: "Rigging & Lifting Tackle", desc: "Shackles, hooks, turnbuckles, and grade 80 lifting chains.", icon: "fas fa-circle" },
