---
interface Props {
  heading: string;
  buttonText: string;
  buttonLink: string;
  subtext?: string;
}

const { heading, buttonText, buttonLink, subtext } = Astro.props;
---
<section class="cta-section text-white">
  <div class="container text-center">
    <h2 class="cta-heading mb-4">{heading}</h2>
    {subtext && (
      <p class="cta-subtext mb-4">{subtext}</p>
    )}
    <a href={buttonLink} class="btn btn-primary btn-lg fw-bold">{buttonText}</a>
  </div>
  <div class="footer-divider"></div>
</section>
